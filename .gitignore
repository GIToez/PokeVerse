# --- Import staging (never commit the original archive or raw extraction) ---
.downloads/
_import/

# --- Large assets ---
# Tibia.spr is stored with Git LFS (see .gitattributes).
# Prebuilt Windows binaries are committed as regular files (see docs/BINARY_INVENTORY.md).
# The PSD/PSB design sources were dropped from the project; keep them out if restored locally.
assets/design-psd/
*.psd
*.psb

# --- Compiler output ---
*.o
*.obj
*.pdb
*.ilk
*.res
server-src/dev-cpp/obj/
server-src/project/obj/
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# --- Logs, crash dumps, runtime state ---
*.log
server/logs/
*.dmp
server/settings.sav
server/forgottenserver.map

# --- Backups and temporary files ---
*.bak
*.tmp
*~
*.swp
Thumbs.db
.DS_Store
desktop.ini

# --- Editor / IDE metadata from the original developers ---
.idea/
.vscode/
*.layout
client/modules/.project/
*.sublime-workspace

# --- Secrets (never commit real credentials) ---
*.pem
*.key
rsakey.private
.env
