# --- Import staging (never commit the original archive or raw extraction) ---
.downloads/
_import/

# --- Original PokeJornadas binaries, kept locally for forensic reference only ---
# See docs/ORIGINAL_BINARY_INVENTORY.md. Never run them for testing.
original/binaries/

# --- Generated output (reproducible; safe to delete) ---
build/
dist/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# --- Compiler output and native binaries anywhere else ---
*.exe
*.dll
*.o
*.obj
*.pdb
*.ilk
*.res
*.lib
*.a
__pycache__/

# --- Design sources (dropped from the project; available in Git history and the original archive) ---
assets/design-psd/

# --- Logs, crash dumps, runtime state ---
*.log
server/runtime-data/logs/
*.dmp
server/runtime-data/settings.sav
server/runtime-data/forgottenserver.map

# --- Backups and temporary files ---
*.bak
*.tmp
*~
*.swp
Thumbs.db
.DS_Store
desktop.ini

# --- Editor / IDE metadata from the original developers ---
.idea/
.vscode/
*.layout
client/runtime-data/modules/.project/
*.sublime-workspace

# --- Secrets (never commit real credentials) ---
*.pem
*.key
rsakey.private
.env
