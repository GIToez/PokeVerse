+    change: Partial<ScheduledEventSpec> & { status?: Exclude<ScheduledEventStatus, "scheduled"> },
+  ): Promise<boolean> {
+    this.eventOp(`edit ${eventId}${change.status ? ` ${change.status}` : ""}`);
+    const event = this.scheduledEvents.get(eventId);
+    if (!event) {
+      return false;
+    }
