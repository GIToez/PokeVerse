# PokeVerse Discord bot (GIToez/PokeVerse-Discord). Installed by scripts/live/bootstrap-ovh.sh,
# enabled by the first deployment that includes the bot.
#
# Independent of the game server: restarting one never restarts the other, and the bot
# reconnects to the game's local bridge (127.0.0.1:7199) on its own.
[Unit]
Description=PokeVerse Discord bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=pokeverse
Group=pokeverse
WorkingDirectory=/opt/pokeverse/discord/current
ExecStart=/opt/pokeverse/discord/current/start-discord.sh start
StandardInput=null
Restart=always
RestartSec=10
TimeoutStopSec=30
MemoryMax=512M
SyslogIdentifier=pokeverse-discord

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/pokeverse/discord/shared

[Install]
WantedBy=multi-user.target
