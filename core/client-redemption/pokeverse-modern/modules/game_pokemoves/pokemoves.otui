// The moves bar in the PokeVerse look (docs/ui-redesign.md): a rounded slot with the move's type on its
// edge, a key chip, an energy chip and a radial cooldown. Images: scripts/art/ui_kit.py.
MoveSlot < UIWidget
  size: 40 40
  image-source: /images/pokeverse-ui/move-empty

  UIItem
    id: icon
    size: 32 32
    virtual: true
    phantom: true
    anchors.centerIn: parent

  // the Mega ability boosts the move (game_pokehud/mega.lua)
  UIWidget
    id: megaGlow
    phantom: true
    visible: false
    border-width: 2
    border-color: #7dffa8
    background-color: #5cf08a22
    anchors.fill: parent
    margin: -2

  // cooldown.png holds 24 frames of 40x40, from just used to almost ready
  UIWidget
    id: cooldown
    size: 40 40
    phantom: true
    visible: false
    image-source: /images/pokeverse-ui/cooldown
    image-clip: 0 0 40 40
    anchors.centerIn: parent

  Label
    id: timer
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: true
    phantom: true
    visible: false
    anchors.centerIn: parent

  Label
    id: key
    font: verdana-11px-rounded
    color: #eef2ff
    text-auto-resize: true
    phantom: true
    image-source: /images/pokeverse-ui/chip
    image-border: 6
    padding: 0 3 0 4
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -4
    margin-left: -3

  Label
    id: energy
    font: verdana-11px-rounded
    color: #e8dcff
    text-auto-resize: true
    phantom: true
    visible: false
    image-source: /images/pokeverse-ui/chip
    image-border: 6
    padding: 0 4 0 4
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: -4
    margin-right: -3
    $on:
      color: #ff6b74

  UIWidget
    id: matchup
    size: 14 14
    phantom: true
    visible: false
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 2

  // the weather boosts (green) or weakens (red) the move (game_weather)
  UIWidget
    id: weather
    size: 16 16
    phantom: true
    visible: false
    background-color: #0a1420d0
    border-width: 1
    border-color: #8ef09a
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 2
    margin-left: 2
    $on:
      border-color: #ff8a8a

    UIWidget
      id: icon
      size: 12 12
      phantom: true
      anchors.centerIn: parent

MoveCardLine < Label
  font: verdana-11px-antialised
  color: #d8e4e4
  text-wrap: true
  text-auto-resize: true
  phantom: true

MoveCardBoost < UIWidget
  height: 16
  phantom: true

  Label
    id: label
    font: verdana-11px-antialised
    color: #d8e4e4
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    text-elide: true
    phantom: true

  Label
    id: value
    font: verdana-11px-antialised
    color: #8ef09a
    text-auto-resize: true
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

MoveCard < UIWidget
  width: 310
  image-source: /images/pokeverse-ui/panel
  image-border: 8
  padding: 10
  focusable: false
  layout:
    type: verticalBox
    fit-children: true
    spacing: 4

  UIWidget
    id: header
    height: 40
    phantom: true

    UIWidget
      id: iconFrame
      size: 40 40
      image-source: /images/pokeverse-ui/move-empty
      anchors.left: parent.left
      anchors.top: parent.top
      phantom: true

      UIItem
        id: icon
        size: 32 32
        virtual: true
        phantom: true
        anchors.centerIn: parent

    Label
      id: name
      font: verdana-11px-rounded
      color: #ffd75a
      anchors.top: parent.top
      anchors.left: iconFrame.right
      anchors.right: close.left
      margin-left: 8
      margin-top: 2
      text-elide: true
      phantom: true

    UIWidget
      id: element
      size: 18 18
      image-smooth: true
      anchors.left: name.left
      anchors.bottom: parent.bottom
      margin-bottom: 1

    UIWidget
      id: category
      size: 18 18
      image-smooth: true
      anchors.left: element.right
      anchors.bottom: element.bottom
      margin-left: 4

    PVCloseButton
      id: close
      size: 20 20
      anchors.top: parent.top
      anchors.right: parent.right

  MoveCardLine
    id: details
    color: #8fdcff

  MoveCardLine
    id: description

  UIWidget
    id: separator
    height: 1
    background-color: #ffffff30
    phantom: true

  UIWidget
    id: boosts
    phantom: true
    layout:
      type: verticalBox
      fit-children: true
      spacing: 1

  MoveCardLine
    id: final
    font: verdana-11px-rounded
    color: #ffffff

  UIWidget
    id: matchupRow
    height: 16
    phantom: true

    UIWidget
      id: badge
      size: 14 14
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    Label
      id: text
      font: verdana-11px-antialised
      color: #d8e4e4
      anchors.left: badge.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text-elide: true

  MoveCardLine
    id: estimate
    color: #ffd75a

UIWindow
  id: movesWindow
  padding: 6
  focusable: false
  anchors.bottom: gameMapPanel.bottom
  anchors.horizontalCenter: gameMapPanel.horizontalCenter
  margin-bottom: 44
