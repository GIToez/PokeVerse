// The Admin window (the frame comes from game_dailytasks, the panels and tabs from game_fishing,
// the buttons and the text field from client_entergame)

AdminText < UILabel
  font: verdana-11px-antialised
  color: #dce6ff
  phantom: true

AdminMuted < AdminText
  color: #96aacd

AdminTab < FishingTab
  size: 46 22
  ttf-font-size: 11

AdminScrollBar < VerticalScrollBar
  step: 28
  pixels-scroll: true

// a label on the left of a row of buttons or picks
AdminRowLabel < AdminMuted
  width: 84
  height: 22
  text-auto-resize: false
  text-align: left

AdminEventRow < UIWidget
  height: 60
  image-source: /modules/game_fishing/images/row
  image-border: 8
  padding: 7 10 7 12

  UILabel
    id: name
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 13
    color: #ffffff
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  AdminMuted
    id: command
    text-auto-resize: true
    anchors.left: name.right
    anchors.verticalCenter: name.verticalCenter
    margin-left: 6

  AdminText
    id: status
    text-auto-resize: true
    anchors.bottom: parent.bottom
    anchors.left: parent.left

  UIWidget
    id: multipliers
    size: 246 22
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -3
    margin-left: 236
    layout:
      type: horizontalBox
      spacing: 4

  UIWidget
    id: durations
    size: 346 22
    anchors.top: multipliers.bottom
    anchors.left: multipliers.left
    margin-top: 4
    layout:
      type: horizontalBox
      spacing: 4

  PVGreenButton
    id: start
    !text: tr('Start')
    size: 76 28
    ttf-font-size: 12
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: -3

  PVRedButton
    id: stop
    !text: tr('Stop')
    size: 76 28
    ttf-font-size: 12
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: -3

// a label and a grid of command buttons (game_admin builds these from SECTIONS)
AdminSection < UIWidget
  height: 26

  AdminRowLabel
    id: label
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2

  UIWidget
    id: buttons
    anchors.top: parent.top
    anchors.left: label.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    layout:
      type: grid
      cell-size: 112 26
      cell-spacing: 6
      flow: true

AdminSectionButton < PVBlueButton
  ttf-font-size: 11

AdminPlayerRow < FishingTab
  height: 26
  text-align: left
  text-offset: 10 -1
  ttf-font-size: 12
  color: #dce6ff

  AdminMuted
    id: level
    text-auto-resize: true
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8

AdminBanRow < UIWidget
  height: 40
  image-source: /modules/game_fishing/images/row
  image-border: 8
  padding: 4 6 4 10

  AdminText
    id: names
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left

  AdminMuted
    id: detail
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: unban.left
    margin-right: 4
    text-auto-resize: false

  PVBlueButton
    id: unban
    !text: tr('Unban')
    size: 60 26
    ttf-font-size: 11
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

AdminCommandHeading < UILabel
  height: 24
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 13
  color: #ffffff
  text-align: bottomLeft
  phantom: true

AdminCommandRow < UIButton
  height: 40
  image-source: /modules/game_fishing/images/row
  image-border: 8
  padding: 4 10 4 10
  $hover:
    image-color: #c8dcff

  UILabel
    id: words
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #ffffff
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  AdminMuted
    id: access
    text-auto-resize: true
    anchors.top: parent.top
    anchors.right: parent.right

  AdminMuted
    id: usage
    text-auto-resize: true
    anchors.left: words.right
    anchors.verticalCenter: words.verticalCenter
    margin-left: 8

  AdminText
    id: help
    text-auto-resize: true
    anchors.bottom: parent.bottom
    anchors.left: parent.left

AdminDecoItem < FishingTab
  size: 132 40

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true
    phantom: true

  UILabel
    id: name
    font: verdana-11px-antialised
    color: #dce6ff
    text-wrap: true
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 2 4 2 4
    text-align: left
    phantom: true

AdminDecoRow < UIWidget
  height: 30
  image-source: /modules/game_fishing/images/row
  image-border: 8
  padding: 0 10 0 6

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -4
    virtual: true
    phantom: true

  AdminText
    id: text
    text-auto-resize: true
    anchors.left: item.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  AdminMuted
    id: note
    text-auto-resize: true
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

// a tab's panel: under the tabs, above the result line
AdminPage < UIWidget
  anchors.top: tabs.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: result.top
  margin-top: 10
  margin-bottom: 8
  visible: false

AdminWindow < UIWindow
  size: 760 744
  image-source: /modules/game_dailytasks/images/window
  image-border: 24
  padding: 22 26 22 26
  draggable: true
  focusable: true
  @onEscape: modules.game_admin.hide()

  UIWidget
    id: headerIcon
    size: 34 34
    image-source: /modules/game_admin/images/icon_admin
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -2
    phantom: true

  UILabel
    id: headerTitle
    !text: tr('Admin')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 22
    color: #ffffff
    text-auto-resize: true
    anchors.left: headerIcon.right
    anchors.top: parent.top
    margin: -3 0 0 10
    phantom: true

  AdminMuted
    id: subtitle
    !text: tr('Staff tools. You see the tabs and buttons your staff rank can use.')
    text-auto-resize: true
    anchors.left: headerTitle.left
    anchors.top: headerTitle.bottom
    margin-top: 1

  PVCloseButton
    id: closeButton
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    @onClick: modules.game_admin.hide()

  AdminText
    id: online
    text-auto-resize: true
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 14

  UIWidget
    id: tabs
    height: 28
    anchors.top: headerIcon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    layout:
      type: horizontalBox
      spacing: 6

    FishingTab
      id: boostsTab
      !text: tr('Boosts')
      width: 96
      @onClick: modules.game_admin.showTab('boosts')

    FishingTab
      id: eventsTab
      !text: tr('Events')
      width: 96
      @onClick: modules.game_admin.showTab('events')

    FishingTab
      id: playersTab
      !text: tr('Players')
      width: 96
      @onClick: modules.game_admin.showTab('players')

    FishingTab
      id: worldTab
      !text: tr('World')
      width: 96
      @onClick: modules.game_admin.showTab('world')

    FishingTab
      id: decorationsTab
      !text: tr('Decorations')
      width: 96
      @onClick: modules.game_admin.showTab('decorations')

    FishingTab
      id: serverTab
      !text: tr('Server')
      width: 96
      @onClick: modules.game_admin.showTab('server')

    FishingTab
      id: commandsTab
      !text: tr('Commands')
      width: 96
      @onClick: modules.game_admin.showTab('commands')

  AdminText
    id: result
    height: 16
    text-auto-resize: false
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

  // Boosts: the experience and shiny events, the calendar and the broadcast
  AdminPage
    id: boosts

    FishingPanel
      id: eventsPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 314

      FishingPanelTitle
        id: title
        !text: tr('Server events')

      AdminMuted
        id: hint
        !text: tr('Starting an event replaces the one running. Everyone online sees a broadcast.')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      UIWidget
        id: rows
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 8
        layout:
          type: verticalBox
          spacing: 6

    FishingPanel
      id: calendar
      anchors.top: eventsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      height: 150

      FishingPanelTitle
        id: title
        !text: tr('Calendar')

      AdminMuted
        !text: tr('Force a season or a holiday, or put it back to its dates. /calendar')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      AdminRowLabel
        id: seasonLabel
        !text: tr('Season')
        anchors.top: title.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: seasons
        height: 22
        anchors.top: seasonLabel.top
        anchors.left: seasonLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      AdminRowLabel
        id: holidayLabel
        !text: tr('Holiday')
        anchors.top: seasonLabel.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: holidays
        height: 48
        anchors.top: holidayLabel.top
        anchors.left: holidayLabel.right
        anchors.right: parent.right
        layout:
          type: grid
          cell-size: 96 22
          cell-spacing: 4
          flow: true

      UIWidget
        id: holidayButtons
        height: 22
        anchors.top: holidays.bottom
        anchors.left: holidays.left
        anchors.right: parent.right
        margin-top: 6
        layout:
          type: horizontalBox
          spacing: 4

    FishingPanel
      id: tools
      anchors.top: calendar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      height: 84

      FishingPanelTitle
        id: title
        !text: tr('Broadcast')

      UIWidget
        id: targets
        size: 290 22
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter
        layout:
          type: horizontalBox
          spacing: 4

        AdminTab
          id: both
          !text: tr('Game + Discord')
          width: 120

        AdminTab
          id: game
          !text: tr('Game only')
          width: 80

        AdminTab
          id: discord
          !text: tr('Discord only')
          width: 82

      AdminMuted
        id: targetLabel
        !text: tr('Broadcast to')
        text-auto-resize: true
        anchors.right: targets.left
        anchors.verticalCenter: title.verticalCenter
        margin-right: 8

      PVField
        id: broadcastText
        !placeholder: tr('Message to broadcast')
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: broadcast.left
        margin: 8 8 0 0
        padding-left: 10
        max-length: 255

      PVBlueButton
        id: broadcast
        !text: tr('Broadcast')
        size: 110 34
        ttf-font-size: 12
        anchors.top: title.bottom
        anchors.right: parent.right
        margin-top: 8

  // Events: every game event, one section each (the wild legendaries for now)
  AdminPage
    id: events

    FishingPanel
      id: legendaries
      anchors.fill: parent

      FishingPanelTitle
        id: title
        !text: tr('Wild legendaries')

      AdminMuted
        !text: tr('Every button runs a /legendary command.')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      AdminRowLabel
        id: modeLabel
        !text: tr('Spawns')
        anchors.top: title.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: mode
        height: 22
        anchors.top: modeLabel.top
        anchors.left: modeLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      AdminRowLabel
        id: setsLabel
        !text: tr('Sets')
        anchors.top: modeLabel.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: sets
        height: 22
        anchors.top: setsLabel.top
        anchors.left: setsLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      AdminRowLabel
        id: speciesLabel
        !text: tr('Pick one')
        anchors.top: setsLabel.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: species
        height: 100
        anchors.top: speciesLabel.top
        anchors.left: speciesLabel.right
        anchors.right: parent.right
        layout:
          type: grid
          cell-size: 97 22
          cell-spacing: 4
          flow: true

      UIWidget
        id: buttons
        height: 86
        anchors.top: species.bottom
        anchors.left: species.left
        anchors.right: parent.right
        margin-top: 8
        layout:
          type: grid
          cell-size: 148 26
          cell-spacing: 4
          flow: true

      AdminRowLabel
        id: specialLabel
        !text: tr('Special')
        anchors.top: buttons.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: special
        height: 86
        anchors.top: specialLabel.top
        anchors.left: specialLabel.right
        anchors.right: parent.right
        layout:
          type: grid
          cell-size: 148 26
          cell-spacing: 4
          flow: true

      AdminRowLabel
        id: statusLabel
        !text: tr('Status')
        anchors.top: special.bottom
        anchors.left: parent.left
        margin-top: 10

      AdminTab
        id: refresh
        !text: tr('Refresh')
        width: 70
        anchors.top: statusLabel.top
        anchors.right: parent.right

      UIWidget
        id: status
        anchors.top: statusLabel.top
        anchors.left: statusLabel.right
        anchors.right: refresh.left
        anchors.bottom: parent.bottom
        margin-right: 8
        layout:
          type: verticalBox
          spacing: 2

  // Players: the players online and the banned accounts on the left, the actions on the right
  AdminPage
    id: players

    FishingPanel
      id: online
      anchors.top: parent.top
      anchors.left: parent.left
      width: 262
      height: 334

      FishingPanelTitle
        id: title
        !text: tr('Online')

      AdminTab
        id: refresh
        !text: tr('Refresh')
        width: 64
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      PVField
        id: search
        !placeholder: tr('Search by name')
        height: 30
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        padding-left: 10
        max-length: 30

      ScrollablePanel
        id: list
        vertical-scrollbar: listScroll
        anchors.top: search.bottom
        anchors.left: parent.left
        anchors.right: listScroll.left
        anchors.bottom: count.top
        margin: 6 4 4 0
        layout:
          type: verticalBox
          spacing: 3

      AdminScrollBar
        id: listScroll
        anchors.top: search.bottom
        anchors.bottom: count.top
        anchors.right: parent.right
        margin: 6 0 4 0

      AdminMuted
        id: count
        height: 14
        text-auto-resize: false
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom

    FishingPanel
      id: bans
      anchors.top: online.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 262
      margin-top: 10

      FishingPanelTitle
        id: title
        !text: tr('Banned accounts')

      ScrollablePanel
        id: list
        vertical-scrollbar: listScroll
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: listScroll.left
        anchors.bottom: parent.bottom
        margin: 8 4 0 0
        layout:
          type: verticalBox
          spacing: 3

      AdminScrollBar
        id: listScroll
        anchors.top: title.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 8

    FishingPanel
      id: player
      anchors.top: parent.top
      anchors.left: online.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10

      FishingPanelTitle
        id: title
        !text: tr('Player')

      PVField
        id: name
        !placeholder: tr('Pick a player or type a name')
        height: 30
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        padding-left: 10
        max-length: 30

      AdminMuted
        id: info
        height: 14
        text-auto-resize: false
        anchors.top: name.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4

      AdminMuted
        id: actionsLabel
        !text: tr('Actions')
        text-auto-resize: true
        anchors.top: info.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: actions
        height: 92
        anchors.top: actionsLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        layout:
          type: grid
          cell-size: 100 28
          cell-spacing: 4
          flow: true

      AdminMuted
        id: townsLabel
        !text: tr('Send to a town\'s temple')
        text-auto-resize: true
        anchors.top: actions.bottom
        anchors.left: parent.left
        margin-top: 8

      ScrollablePanel
        id: towns
        vertical-scrollbar: townsScroll
        height: 74
        anchors.top: townsLabel.bottom
        anchors.left: parent.left
        anchors.right: townsScroll.left
        margin: 4 4 0 0
        layout:
          type: grid
          cell-size: 96 22
          cell-spacing: 4
          flow: true

      AdminScrollBar
        id: townsScroll
        height: 74
        anchors.top: townsLabel.bottom
        anchors.right: parent.right
        margin-top: 4

      AdminMuted
        id: banLabel
        !text: tr('Ban the account: how long and why')
        text-auto-resize: true
        anchors.top: towns.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: banDays
        height: 22
        anchors.top: banLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        layout:
          type: horizontalBox
          spacing: 4

      UIWidget
        id: banReasons
        height: 74
        anchors.top: banDays.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        layout:
          type: grid
          cell-size: 136 22
          cell-spacing: 4
          flow: true

      PVField
        id: banComment
        !placeholder: tr('Comment (the player doesn\'t see it)')
        height: 30
        anchors.top: banReasons.bottom
        anchors.left: parent.left
        anchors.right: ban.left
        margin: 6 8 0 0
        padding-left: 10
        max-length: 200

      PVRedButton
        id: ban
        !text: tr('Ban')
        size: 100 30
        ttf-font-size: 12
        anchors.top: banReasons.bottom
        anchors.right: parent.right
        margin-top: 6

  // World: the weather and the game clock
  AdminPage
    id: world

    FishingPanel
      id: weather
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 278

      FishingPanelTitle
        id: title
        !text: tr('Weather')

      AdminMuted
        !text: tr('Staff weather stays until it runs out or goes back to auto. /weather')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      AdminRowLabel
        id: whereLabel
        !text: tr('Where')
        anchors.top: title.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: targets
        height: 22
        anchors.top: whereLabel.top
        anchors.left: whereLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      AdminRowLabel
        id: kindLabel
        !text: tr('Weather')
        anchors.top: whereLabel.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: kinds
        height: 48
        anchors.top: kindLabel.top
        anchors.left: kindLabel.right
        anchors.right: parent.right
        layout:
          type: grid
          cell-size: 112 22
          cell-spacing: 4
          flow: true

      AdminRowLabel
        id: forLabel
        !text: tr('For')
        anchors.top: kinds.bottom
        anchors.left: parent.left
        margin-top: 8

      UIWidget
        id: durations
        height: 22
        anchors.top: forLabel.top
        anchors.left: forLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      UIWidget
        id: buttons
        height: 30
        anchors.top: durations.bottom
        anchors.left: durations.left
        anchors.right: parent.right
        margin-top: 10
        layout:
          type: horizontalBox
          spacing: 6

      AdminRowLabel
        id: clockLabel
        !text: tr('Game clock')
        anchors.top: buttons.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: clock
        height: 22
        anchors.top: clockLabel.top
        anchors.left: clockLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

      AdminRowLabel
        id: regionsLabel
        !text: tr('Regions')
        anchors.top: clock.bottom
        anchors.left: parent.left
        margin-top: 10

      UIWidget
        id: regions
        height: 22
        anchors.top: regionsLabel.top
        anchors.left: regionsLabel.right
        anchors.right: parent.right
        layout:
          type: horizontalBox
          spacing: 4

  FishingPanel
    id: decorations
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: result.top
    margin-top: 10
    margin-bottom: 8
    visible: false

    FishingPanelTitle
      id: title
      !text: tr('Decorations')

    AdminText
      id: status
      text-auto-resize: true
      anchors.right: parent.right
      anchors.verticalCenter: title.verticalCenter

    AdminMuted
      id: setsLabel
      !text: tr('Set: the props go up whenever this set is up')
      text-auto-resize: true
      anchors.top: title.bottom
      anchors.left: parent.left
      margin-top: 10

    UIWidget
      id: sets
      height: 52
      anchors.top: setsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      layout:
        type: grid
        cell-size: 94 24
        cell-spacing: 4
        flow: true

    AdminMuted
      id: itemsLabel
      !text: tr('Prop: wall props hang on the wall you face, the others stand on the tile you face')
      text-auto-resize: true
      anchors.top: sets.bottom
      anchors.left: parent.left
      margin-top: 10

    UIWidget
      id: items
      height: 132
      anchors.top: itemsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      layout:
        type: grid
        cell-size: 132 40
        cell-spacing: 6
        flow: true

    PVGreenButton
      id: place
      !text: tr('Place in front of me')
      size: 164 30
      ttf-font-size: 12
      anchors.top: items.bottom
      anchors.left: parent.left
      margin-top: 10

    PVRedButton
      id: remove
      !text: tr('Remove in front of me')
      size: 164 30
      ttf-font-size: 12
      anchors.top: place.top
      anchors.left: place.right
      margin-left: 8

    PVBlueButton
      id: preview
      size: 164 30
      ttf-font-size: 12
      anchors.top: place.top
      anchors.left: remove.right
      margin-left: 8

    PVBlueButton
      id: auto
      size: 176 30
      ttf-font-size: 12
      anchors.top: place.top
      anchors.left: preview.right
      margin-left: 8

    AdminText
      id: result
      text-auto-resize: true
      anchors.top: place.bottom
      anchors.left: parent.left
      margin-top: 8

    AdminMuted
      id: spotsTitle
      text-auto-resize: true
      anchors.top: result.bottom
      anchors.left: parent.left
      margin-top: 10

    AdminTab
      id: refresh
      !text: tr('Refresh')
      width: 70
      anchors.right: parent.right
      anchors.verticalCenter: spotsTitle.verticalCenter

    UIWidget
      id: spots
      anchors.top: spotsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      layout:
        type: verticalBox
        spacing: 4

  // Server: rows of command buttons (SERVER_SECTIONS in admin.lua)
  AdminPage
    id: server

    FishingPanel
      id: panel
      anchors.fill: parent

      FishingPanelTitle
        id: title
        !text: tr('Server')

      AdminMuted
        !text: tr('Each button runs the staff command in its tooltip. Answers go to the Server Log.')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      UIWidget
        id: sections
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 10
        layout:
          type: verticalBox
          spacing: 8

  // Commands: every staff command you can use; type one (or click it) and run it
  AdminPage
    id: commands

    FishingPanel
      id: panel
      anchors.fill: parent

      FishingPanelTitle
        id: title
        !text: tr('Commands')

      AdminMuted
        id: hint
        !text: tr('Typing filters the list. Click a command to fill it in.')
        text-auto-resize: true
        anchors.right: parent.right
        anchors.verticalCenter: title.verticalCenter

      PVField
        id: text
        !placeholder: tr('/command and its parameters')
        height: 34
        anchors.top: title.bottom
        anchors.left: parent.left
        anchors.right: run.left
        margin: 8 8 0 0
        padding-left: 10
        max-length: 255

      PVGreenButton
        id: run
        !text: tr('Run')
        size: 110 34
        ttf-font-size: 12
        anchors.top: title.bottom
        anchors.right: parent.right
        margin-top: 8

      ScrollablePanel
        id: list
        vertical-scrollbar: listScroll
        anchors.top: text.bottom
        anchors.left: parent.left
        anchors.right: listScroll.left
        anchors.bottom: parent.bottom
        margin: 10 4 0 0
        layout:
          type: verticalBox
          spacing: 4

      AdminScrollBar
        id: listScroll
        anchors.top: text.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 10
