HudPanel < UIWidget
  image-source: /modules/game_pokehud/images/panel
  image-border: 9
  phantom: true

// the track image and the caps come from the height (pokehud.lua, initTrack)
HudTrack < UIWidget
  height: 11

  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    phantom: true

  Label
    id: text
    font: Verdana Bold-11px-outline
    color: #ffffff
    text-align: center
    anchors.fill: parent
    phantom: true

HudText < Label
  font: Verdana Bold-11px
  color: #e8ecec
  text-auto-resize: true
  phantom: true

HudBall < UIWidget
  image-source: /modules/game_pokehud/images/ball-empty
  size: 14 14
  margin-left: 3

HudCoin < UIWidget
  image-source: /modules/game_pokehud/images/panel
  image-border: 9
  height: 22
  padding-left: 6
  padding-right: 10

  UIItem
    id: icon
    size: 16 16
    virtual: true
    phantom: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  HudText
    id: amount
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5

UIWidget
  id: pokeHud
  size: 500 138
  phantom: true
  focusable: false

  HudPanel
    id: experiencePanel
    size: 340 22
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter

    HudText
      id: level
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 12

    HudTrack
      id: experience
      height: 6
      anchors.left: level.right
      anchors.right: experienceText.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-right: 10
      phantom: false

    HudText
      id: experienceText
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12

  HudPanel
    id: mainPanel
    size: 500 58
    anchors.top: experiencePanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5

    HudText
      id: trainerName
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 14
      margin-top: 5

    UIWidget
      id: heart
      image-source: /modules/game_pokehud/images/heart
      size: 12 11
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 14
      margin-bottom: 20
      phantom: true

    HudTrack
      id: health
      height: 13
      anchors.left: heart.right
      anchors.right: parent.horizontalCenter
      anchors.verticalCenter: heart.verticalCenter
      margin-left: 6
      margin-right: 44
      phantom: false

    // Mega Evolution (mega.lua): only with the Mega Ring worn. Images: scripts/art/mega_hud_art.py
    UIWidget
      id: megaIcon
      image-source: /modules/game_pokehud/images/mega
      size: 11 11
      anchors.horizontalCenter: heart.horizontalCenter
      anchors.verticalCenter: megaBar.verticalCenter
      phantom: true
      visible: false

    HudTrack
      id: megaBar
      height: 11
      anchors.left: health.left
      anchors.right: health.right
      anchors.top: health.bottom
      margin-top: 4
      margin-right: 22
      phantom: false
      visible: false

    UIWidget
      id: megaButton
      image-source: /modules/game_pokehud/images/mega-button-off
      size: 18 18
      anchors.left: megaBar.right
      anchors.verticalCenter: megaBar.verticalCenter
      margin-left: 4
      visible: false

      Label
        id: key
        font: small-9px
        color: #c8d0dc
        text-auto-resize: true
        phantom: true
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-right: -4
        margin-bottom: -3
        $on:
          color: #ffe27a

    HudText
      id: pokemonName
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 14
      margin-top: 5

    HudTrack
      id: pokemonHealth
      height: 13
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.verticalCenter: heart.verticalCenter
      margin-left: 44
      margin-right: 14
      phantom: false

    UIWidget
      id: bolt
      image-source: /modules/game_pokehud/images/bolt
      size: 9 12
      anchors.right: pokemonEnergy.left
      anchors.verticalCenter: pokemonEnergy.verticalCenter
      margin-right: 5
      phantom: true

    HudTrack
      id: pokemonEnergy
      height: 11
      anchors.left: pokemonHealth.left
      anchors.right: pokemonHealth.right
      anchors.top: pokemonHealth.bottom
      margin-top: 4
      margin-left: 14
      phantom: false

  UIWidget
    id: conditions
    height: 12
    anchors.top: mainPanel.bottom
    anchors.left: mainPanel.left
    anchors.right: portrait.left
    margin-top: 4
    margin-left: 14
    phantom: true
    layout:
      type: horizontalBox
      spacing: 2

  UIWidget
    id: portrait
    image-source: /modules/game_pokehud/images/portrait-disc
    size: 66 66
    anchors.horizontalCenter: mainPanel.horizontalCenter
    anchors.verticalCenter: mainPanel.verticalCenter

    UICreature
      id: creature
      size: 50 50
      anchors.centerIn: parent
      phantom: true

    UIWidget
      id: ring
      image-source: /modules/game_pokehud/images/portrait-ring
      anchors.fill: parent
      phantom: true

  UIWidget
    id: party
    size: 102 16
    anchors.top: portrait.bottom
    anchors.horizontalCenter: portrait.horizontalCenter
    margin-top: 3
    phantom: true

  UIWidget
    id: coins
    height: 22
    anchors.top: mainPanel.bottom
    anchors.right: mainPanel.right
    margin-top: 4
    phantom: true
    layout:
      type: horizontalBox
      spacing: 6
      fit-children: true

    HudCoin
      id: soulCoins
      !tooltip: tr('Verse Orbs you are carrying')

    HudCoin
      id: dollars
      !tooltip: tr('Dollars you are carrying')
