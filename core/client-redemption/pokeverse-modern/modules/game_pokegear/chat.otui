// Chat: game_console's channels as a Pokegear card, and the lines that float over the map while
// it's folded. Built by chat.lua; the text line is game_console's own consoleTextEdit.
PokegearChatChip < UIButton
  height: 20
  text-auto-resize: true
  padding: 0 10
  text-offset: 0 4
  image-source: /modules/game_pokegear/images/pill
  image-border: 9
  image-smooth: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 11
  color: #8fa0c4
  $on:
    image-source: /modules/game_pokegear/images/pill_on
    color: #eef2ff
    text-offset: 0 1
  $hover:
    color: #eef2ff

  UILabel
    id: count
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: -4
    margin-top: -5
    height: 13
    text-auto-resize: true
    padding: 0 4
    text-offset: 0 1
    image-source: /modules/game_pokegear/images/bar_fill
    image-border: 3
    image-color: #e5484d
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 9
    color: #ffffff
    phantom: true
    visible: false

PokegearChatFace < UIButton
  size: 24 24
  image-source: /modules/game_pokegear/images/face
  image-border: 12
  image-smooth: true
  text-offset: 0 2
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 10
  color: #eef2ff
  $on:
    color: #ffcb05

  UILabel
    id: count
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: -4
    margin-top: -4
    height: 13
    text-auto-resize: true
    padding: 0 4
    text-offset: 0 1
    image-source: /modules/game_pokegear/images/bar_fill
    image-border: 3
    image-color: #e5484d
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 9
    color: #ffffff
    phantom: true
    visible: false

PokegearChatTag < UILabel
  height: 14
  text-auto-resize: true
  padding: 0 5
  text-offset: 0 1
  image-source: /modules/game_pokegear/images/bar_fill
  image-border: 3
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 9
  color: #0d1424
  phantom: true

PokegearChatRow < UIWidget
  height: 40
  padding: 4 6 4 6
  phantom: false
  $hover:
    image-source: /modules/game_pokegear/images/row
    image-border: 11

  UILabel
    id: face
    size: 24 24
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /modules/game_pokegear/images/face
    image-border: 12
    image-smooth: true
    text-align: center
    text-offset: 0 1
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #eef2ff
    phantom: true

  UILabel
    id: name
    anchors.left: face.right
    anchors.top: parent.top
    margin-left: 8
    height: 14
    text-auto-resize: true
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #eef2ff
    phantom: true

  UIWidget
    id: tags
    anchors.left: name.right
    anchors.verticalCenter: name.verticalCenter
    margin-left: 5
    height: 14
    width: 1
    layout:
      type: horizontalBox
      spacing: 3
      fit-children: true
    phantom: true

  UILabel
    id: time
    anchors.left: tags.right
    anchors.verticalCenter: name.verticalCenter
    margin-left: 5
    text-auto-resize: true
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 9
    color: #6f7fa3
    phantom: true

  UILabel
    id: text
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 2
    text-wrap: true
    text-auto-resize: true
    text-align: topLeft
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #c9d3ea
    phantom: true

// a floating line while the chat is folded: the channel tag, then the line
PokegearChatFloat < UIWidget
  height: 22
  padding: 4 8 4 6
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  opacity: 0.85
  phantom: true

  PokegearChatTag
    id: tag
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 1

  UILabel
    id: text
    anchors.left: tag.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    text-wrap: true
    text-auto-resize: true
    text-align: topLeft
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #eef2ff
    phantom: true

PokegearChat < UIWidget
  id: pokegearChat
  width: 430
  height: 250
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  padding: 8 10 8 10
  focusable: false

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    draggable: true
    !tooltip: tr('Drag to move')

    UIWidget
      id: chips
      anchors.left: parent.left
      anchors.right: faces.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      height: 24
      layout:
        type: horizontalBox
        spacing: 4
      phantom: true

    UIWidget
      id: faces
      anchors.right: fold.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      height: 24
      width: 1
      layout:
        type: horizontalBox
        spacing: 4
        fit-children: true
      phantom: true

    UIButton
      id: fold
      size: 20 20
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      image-source: /modules/game_pokegear/images/pill
      image-border: 9
      image-smooth: true
      text: -
      text-offset: 0 -1
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 13
      color: #eef2ff
      !tooltip: tr('Fold the chat: the last lines float over the map')
      $hover:
        image-source: /modules/game_pokegear/images/pill_on

  UIScrollArea
    id: list
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: input.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 12
    vertical-scrollbar: scroll
    layout:
      type: verticalBox
      spacing: 0

  VerticalScrollBar
    id: scroll
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.left: list.right
    margin-left: 4
    width: 8
    step: 28
    pixels-scroll: true

  UIWidget
    id: input
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26
    image-source: /modules/game_pokegear/images/pill
    image-border: 9
    image-smooth: true

    PokegearChatTag
      id: channel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6

    UILabel
      id: hint
      anchors.left: channel.right
      anchors.right: open.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      height: 16
      text-offset: 0 2
      !text: tr('Press Enter to chat')
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 11
      color: #6f7fa3
      phantom: true

    UIWidget
      id: slot
      anchors.left: channel.right
      anchors.right: open.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 4
      phantom: true

    UIButton
      id: open
      size: 22 18
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      image-source: /modules/game_pokegear/images/pill
      image-border: 9
      image-smooth: true
      text: ^
      text-offset: 0 3
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 11
      color: #eef2ff
      !tooltip: tr('Open the chat')
      visible: false
      $hover:
        image-source: /modules/game_pokegear/images/pill_on

    PokegearChip
      id: enterChip
      anchors.right: open.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      !text: tr('Enter')

PokegearChatFloats < UIWidget
  id: pokegearChatFloats
  width: 430
  height: 10
  phantom: true
  layout:
    type: verticalBox
    spacing: 3
    fit-children: true
