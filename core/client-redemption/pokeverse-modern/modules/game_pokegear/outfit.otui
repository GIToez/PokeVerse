// Customise Trainer (the trainer's outfit, addons and colours) and Pokemon Outfit (only the outfit:
// Pokemon keep their own colours). Tiles and swatches are built by outfit.lua.
PokegearOutfitTile < UIButton
  size: 68 78
  image-source: /modules/game_pokegear/images/row
  image-border: 11
  image-smooth: true
  $hover:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 0.85
  $on:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 1

  UICreature
    id: creature
    size: 52 52
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    phantom: true

  UILabel
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 4 5 4
    height: 14
    text-align: center
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #c9d3ee
    phantom: true

  UIWidget
    id: lock
    size: 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 5 5 0 0
    image-source: /modules/game_trainercard/images/icon_lock
    image-smooth: true
    phantom: true
    visible: false

PokegearOutfitSwatch < UIButton
  size: 16 16
  border-width: 1
  border-color: #0d1424
  $hover:
    border-color: #eef2ff
  $on:
    border-width: 2
    border-color: #ffcb05

PokegearOutfitLabel < UILabel
  height: 14
  text-auto-resize: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 10
  color: #8fa0c4
  phantom: true

PokegearOutfitStage < UIWidget
  image-source: /modules/game_pokegear/images/row
  image-border: 11
  image-smooth: true

  UICreature
    id: creature
    size: 160 160
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: -14
    phantom: true

  PokegearPill
    id: left
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin: 0 0 6 6
    text: <
    !tooltip: tr('Turn')

  PokegearPill
    id: right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 6 6 0
    text: >
    !tooltip: tr('Turn')

  UILabel
    id: name
    anchors.left: left.right
    anchors.right: right.left
    anchors.verticalCenter: left.verticalCenter
    margin: 0 4
    height: 16
    text-align: center
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #eef2ff
    phantom: true

PokegearOutfitHeader < UIWidget
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  height: 24
  draggable: true
  !tooltip: tr('Drag to move')

  UILabel
    id: title
    anchors.left: parent.left
    anchors.right: close.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    height: 24
    ttf-font: /fonts/ttf/pixelify-sans.ttf
    ttf-font-size: 18
    color: #ffcb05
    phantom: true

  PVCloseButton
    id: close
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    !tooltip: tr('Close')

PokegearOutfitWindow < UIWidget
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  padding: 8 10 10 10
  anchors.centerIn: parent
  focusable: true

  PokegearOutfitHeader
    id: header

  UIWidget
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 24

    PokegearSocialAction
      id: save
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      !text: tr('Save')

    PokegearSocialAction
      id: cancel
      anchors.right: save.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      !text: tr('Cancel')

PokegearTrainerOutfit < PokegearOutfitWindow
  id: pokegearTrainerOutfit
  size: 620 448

  PokegearOutfitStage
    id: stage
    anchors.top: header.bottom
    anchors.left: parent.left
    margin-top: 8
    size: 216 240

  PokegearOutfitLabel
    id: addonsLabel
    anchors.top: stage.bottom
    anchors.left: stage.left
    margin-top: 10
    !text: tr('Addons')

  UIWidget
    id: addons
    anchors.top: addonsLabel.bottom
    anchors.left: stage.left
    anchors.right: stage.right
    margin-top: 4
    height: 20
    layout:
      type: horizontalBox
      spacing: 4

    PokegearPill
      id: addon1
      !text: tr('Addon 1')
    PokegearPill
      id: addon2
      !text: tr('Addon 2')

  UILabel
    id: noAddons
    anchors.top: addonsLabel.bottom
    anchors.left: stage.left
    anchors.right: stage.right
    margin-top: 4
    height: 20
    text-wrap: true
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #6f7fa3
    !text: tr('This outfit has no addons.')
    visible: false

  PokegearOutfitLabel
    id: outfitsLabel
    anchors.top: header.bottom
    anchors.left: stage.right
    margin-top: 8
    margin-left: 12

  UIScrollArea
    id: list
    anchors.top: outfitsLabel.bottom
    anchors.left: outfitsLabel.left
    anchors.right: parent.right
    margin-top: 4
    margin-right: 12
    height: 166
    vertical-scrollbar: scroll
    layout:
      type: grid
      cell-size: 68 78
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: scroll
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.left: list.right
    margin-left: 4
    width: 8
    step: 82
    pixels-scroll: true

  UIWidget
    id: parts
    anchors.top: list.bottom
    anchors.left: list.left
    anchors.right: parent.right
    margin-top: 10
    height: 20
    layout:
      type: horizontalBox
      spacing: 4

    PokegearPill
      id: head
      !text: tr('Hair')
    PokegearPill
      id: body
      !text: tr('Primary')
    PokegearPill
      id: legs
      !text: tr('Secondary')
    PokegearPill
      id: feet
      !text: tr('Accent')

  PokegearPill
    id: random
    anchors.right: parent.right
    anchors.top: parts.top
    !text: tr('Random')
    !tooltip: tr('Random colours')

  UIWidget
    id: palette
    anchors.top: parts.bottom
    anchors.left: list.left
    margin-top: 8
    size: 340 124
    layout:
      type: grid
      cell-size: 16 16
      cell-spacing: 2
      num-columns: 19
      flow: true

PokegearPokemonOutfit < PokegearOutfitWindow
  id: pokegearPokemonOutfit
  size: 480 360

  PokegearOutfitStage
    id: stage
    anchors.top: header.bottom
    anchors.left: parent.left
    margin-top: 8
    size: 180 254

  PokegearOutfitLabel
    id: outfitsLabel
    anchors.top: header.bottom
    anchors.left: stage.right
    margin-top: 8
    margin-left: 12
    !text: tr('Outfits')

  UIScrollArea
    id: list
    anchors.top: outfitsLabel.bottom
    anchors.left: outfitsLabel.left
    anchors.right: parent.right
    anchors.bottom: stage.bottom
    margin-top: 4
    margin-right: 12
    vertical-scrollbar: scroll
    layout:
      type: grid
      cell-size: 68 78
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: scroll
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.left: list.right
    margin-left: 4
    width: 8
    step: 82
    pixels-scroll: true

  UILabel
    id: hint
    anchors.left: parent.left
    anchors.right: footer.right
    anchors.top: stage.bottom
    anchors.bottom: footer.top
    margin: 6 150 4 0
    text-wrap: true
    text-align: left
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4
    !text: tr('Pokemon keep their own colours. Use a Pokemon addon on your Pokemon to add an outfit.')
