// The Pokegear Bag: the trainer belt, a tab per bag, the category rail and the open bag as a grid.
// Built by bag.lua.
PokegearBagItem < Item
  image-source: /modules/game_pokegear/images/tile
  image-border: 6
  padding: 4
  font: verdana-11px-rounded

PokegearBeltSlot < Item
  size: 36 36
  image-source: /modules/game_pokegear/images/tile
  image-border: 6
  padding: 3
  $on:
    image-source: /modules/game_pokegear/images/tile_out

  UILabel
    id: key
    anchors.bottom: parent.top
    anchors.left: parent.left
    margin-bottom: 1
    text-auto-resize: true
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #ffcb05
    phantom: true

  UIItem
    id: face
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: -5
    margin-right: -5
    size: 20 20
    virtual: true
    phantom: true
    visible: false

  UILabel
    id: out
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -7
    height: 13
    text-auto-resize: true
    padding: 0 4
    !text: tr('OUT')
    image-source: /modules/game_pokegear/images/chip_gold
    image-border: 5
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 9
    color: #1a1a1a
    phantom: true
    visible: false

PokegearBagTab < UIButton
  height: 24
  image-source: /modules/game_pokegear/images/pill
  image-border: 9
  image-smooth: true
  $on:
    image-source: /modules/game_pokegear/images/pill_on

  UIItem
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 18 18
    draggable: true

  UILabel
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    text-auto-resize: true
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #eef2ff
    phantom: true

PokegearBagAddTab < UIButton
  size: 26 24
  !text: '+'
  image-source: /modules/game_pokegear/images/pill
  image-border: 9
  image-smooth: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 14
  color: #8fa0c4
  $hover:
    color: #ffcb05

PokegearBagArrow < UIButton
  size: 18 24
  image-source: /modules/game_pokegear/images/pill
  image-border: 9
  image-smooth: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 12
  color: #eef2ff
  $hover:
    color: #ffcb05
  $disabled:
    color: #4a5675

PokegearBagNameEdit < UITextEdit
  size: 120 24
  padding: 0 10
  text-align: left
  image-source: /modules/game_pokegear/images/pill_on
  image-border: 9
  image-smooth: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 11
  color: #eef2ff

PokegearBagRailButton < UIButton
  size: 26 24
  image-source: /modules/game_pokegear/images/pill
  image-border: 9
  image-smooth: true
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 10
  color: #8fa0c4
  $on:
    image-source: /modules/game_pokegear/images/pill_on
    color: #eef2ff
  $hover:
    color: #eef2ff

  UIItem
    id: icon
    anchors.centerIn: parent
    size: 20 20
    virtual: true
    phantom: true

PokegearBagPin < Item
  size: 24 24
  image-source: /modules/game_pokegear/images/tile
  image-border: 6
  padding: 2
  virtual: true

PokegearBagRulePill < PokegearPill
  width: 104
  text-auto-resize: false

// a bag's sort rules: the categories it takes and the items pinned to it
PokegearBagRules < UIWidget
  id: pokegearBagRules
  width: 352
  height: 200
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  padding: 8 10 10 10

  UILabel
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: close.left
    height: 24
    text-align: left
    ttf-font: /fonts/ttf/pixelify-sans.ttf
    ttf-font-size: 18
    color: #ffcb05

  PVCloseButton
    id: close
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    !tooltip: tr('Cancel')

  UILabel
    id: hint
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text-wrap: true
    text-auto-resize: true
    !text: tr('New items go to the first bag that takes them, unless a stack of the same item is already in a bag. What you drag by hand stays where you put it.')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4

  UILabel
    id: takesLabel
    anchors.top: hint.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    !text: tr('Takes')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #eef2ff

  UIWidget
    id: categories
    anchors.top: takesLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 20
    layout:
      type: grid
      cell-size: 108 20
      cell-spacing: 3
      flow: true
      fit-children: true

  UILabel
    id: pinsLabel
    anchors.top: categories.bottom
    anchors.left: parent.left
    margin-top: 8
    text-auto-resize: true
    !text: tr('Always here')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #eef2ff

  UILabel
    id: pinsHint
    anchors.verticalCenter: pinsLabel.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    !text: tr('drop an item to pin it, right-click to unpin')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4

  UIWidget
    id: pins
    anchors.top: pinsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 24
    layout:
      type: horizontalBox
      spacing: 3

  PokegearPill
    id: save
    anchors.top: pins.bottom
    anchors.right: parent.right
    margin-top: 10
    !text: tr('Save')

  PokegearPill
    id: cancel
    anchors.top: save.top
    anchors.right: save.left
    margin-right: 4
    !text: tr('Cancel')

  PokegearPill
    id: clear
    anchors.top: save.top
    anchors.left: parent.left
    !text: tr('Clear')
    !tooltip: tr('Take every category and pin off this bag')

PokegearBag < UIWidget
  id: pokegearBag
  width: 334
  height: 300
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  padding: 8 10 10 10
  focusable: false

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    draggable: true
    !tooltip: tr('Drag to move')

    UILabel
      id: title
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      text-auto-resize: true
      !text: tr('Bag')
      ttf-font: /fonts/ttf/pixelify-sans.ttf
      ttf-font-size: 18
      color: #ffcb05
      phantom: true

    PVCloseButton
      id: close
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      !tooltip: tr('Close')

    PokegearChip
      id: keyChip
      anchors.right: close.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6

    PokegearPill
      id: sort
      anchors.right: count.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      !text: tr('Sort')
      !tooltip: tr('Sort my bags now: move what you carry to the bags whose rules take it')

    UILabel
      id: count
      anchors.right: keyChip.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      text-auto-resize: true
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 11
      color: #8fa0c4
      phantom: true

  UILabel
    id: beltLabel
    anchors.top: header.bottom
    anchors.left: parent.left
    margin-top: 16
    size: 28 36
    text-align: left
    !text: tr('Belt')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #8fa0c4

  UIWidget
    id: belt
    anchors.top: header.bottom
    anchors.left: beltLabel.right
    anchors.right: parent.right
    margin-top: 16
    margin-left: 8
    height: 36
    layout:
      type: horizontalBox
      spacing: 3

  UIWidget
    id: tabs
    anchors.top: belt.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 24
    layout:
      type: horizontalBox
      spacing: 4

  UIWidget
    id: rail
    anchors.top: tabs.bottom
    anchors.left: parent.left
    margin-top: 8
    width: 26
    height: 24
    layout:
      type: verticalBox
      spacing: 2

  UILabel
    id: gridTitle
    anchors.top: tabs.bottom
    anchors.left: rail.right
    margin-top: 8
    margin-left: 6
    height: 16
    text-auto-resize: true
    !text: tr('All')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #eef2ff
    phantom: true

  UILabel
    id: gridHint
    anchors.top: tabs.bottom
    anchors.right: parent.right
    margin-top: 9
    height: 16
    text-auto-resize: true
    !text: tr('right-click to use')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4
    phantom: true

  UIScrollArea
    id: grid
    anchors.top: gridTitle.bottom
    anchors.left: rail.right
    anchors.right: gridScroll.left
    margin-top: 4
    margin-left: 6
    margin-right: 2
    height: 200
    vertical-scrollbar: gridScroll
    layout:
      type: grid
      cell-size: 42 42
      cell-spacing: 3
      flow: true

  VerticalScrollBar
    id: gridScroll
    anchors.top: gridTitle.bottom
    anchors.right: parent.right
    margin-top: 4
    height: 200
    step: 45
    pixels-scroll: true
