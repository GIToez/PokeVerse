// Phones and tablets (docs/concepts/phone-layout): the top bar's apps drawer and the actions button by
// the moves bar. Built by phone.lua, only on mobile.
PokegearPhoneButton < UIButton
  size: 32 32
  image-source: /modules/game_pokegear/images/button
  image-smooth: true
  $on:
    image-source: /modules/game_pokegear/images/button_hover
  $pressed:
    opacity: 0.8

  UIWidget
    id: icon
    size: 22 22
    anchors.centerIn: parent
    image-smooth: true
    phantom: true

PokegearPhoneScrim < UIWidget
  anchors.fill: parent
  focusable: false
  visible: false

PokegearAppsDrawer < UIWidget
  image-source: /modules/game_pokegear/images/card
  image-border: 12
  image-smooth: true
  padding: 10
  focusable: false
  visible: false

  UIWidget
    id: tiles
    anchors.fill: parent
    phantom: true
    layout:
      type: grid
      cell-size: 76 70
      cell-spacing: 6
      num-columns: 5

PokegearAppTile < UIWidget
  focusable: false

  UILabel
    id: label
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 16
    text-align: center
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #eef2ff
    phantom: true
