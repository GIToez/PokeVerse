// Event Token Shop. Frame from game_dailytasks, panels and rows from game_fishing, chips from
// game_mart, buttons and fields from client_entergame, scroll bar from game_gts.

EventShopText < UILabel
  font: verdana-11px-antialised
  color: #dce6ff
  phantom: true

EventShopMuted < EventShopText
  color: #96aacd

EventShopBold < UILabel
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 12
  color: #ffffff
  text-auto-resize: true
  phantom: true

EventShopChip < UIButton
  height: 24
  padding: 0 12 0 12
  image-source: /modules/game_fishing/images/tab
  image-border: 8
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 11
  color: #96aacd
  text-auto-resize: true
  text-offset: 0 1
  focusable: false
  $hover !on:
    color: #dce6ff
  $on:
    image-source: /modules/game_fishing/images/tab_on
    color: #ffffff

EventShopCard < UIButton
  height: 52
  image-source: /modules/game_fishing/images/row
  image-border: 8
  focusable: false
  $hover !checked !on:
    image-source: /modules/game_fishing/images/row_hover
  $checked:
    image-source: /modules/game_fishing/images/row_on
  $on:
    image-source: /modules/game_fishing/images/row_locked
    opacity: 0.6

  UIWidget
    id: frame
    size: 40 40
    image-source: /modules/game_fishing/images/portrait
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

    UIItem
      id: item
      size: 32 32
      anchors.centerIn: parent
      virtual: true
      phantom: true

  EventShopBold
    id: name
    color: #ffd75a
    anchors.left: frame.right
    anchors.top: parent.top
    margin: 9 0 0 8

  EventShopMuted
    id: note
    text-auto-resize: false
    anchors.left: name.left
    anchors.right: price.left
    anchors.top: name.bottom
    margin: 3 6 0 0
    height: 14

  EventShopBold
    id: price
    color: #7ee08f
    ttf-font-size: 13
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10

EventShopWindow < UIWindow
  size: 860 560
  image-source: /modules/game_dailytasks/images/window
  image-border: 24
  padding: 22 26 22 26
  draggable: true
  focusable: true
  @onEscape: modules.game_eventshop.close()

  UILabel
    id: headerTitle
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 20
    color: #ffffff
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  EventShopMuted
    id: subtitle
    text-auto-resize: true
    anchors.left: headerTitle.left
    anchors.top: headerTitle.bottom
    margin-top: 2

  PVCloseButton
    id: closeButton
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    @onClick: modules.game_eventshop.close()

  FishingPanel
    id: bank
    size: 190 42
    padding: 4 10 4 10
    anchors.top: parent.top
    anchors.right: closeButton.left
    margin: -4 14 0 0

    UIItem
      id: coin
      size: 32 32
      virtual: true
      phantom: true
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    EventShopMuted
      id: caption
      text-auto-resize: true
      anchors.top: parent.top
      anchors.left: coin.right
      margin-left: 6

    UILabel
      id: balance
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 15
      color: #ffd75a
      text-auto-resize: true
      anchors.top: caption.bottom
      anchors.left: caption.left
      margin-top: 1
      phantom: true

  UIWidget
    id: chips
    height: 24
    anchors.top: subtitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    layout:
      type: horizontalBox
      spacing: 6

  PVField
    id: search
    height: 28
    padding: 6 8 6 8
    !placeholder: tr('Search rewards')
    anchors.top: chips.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  FishingPanel
    id: detail
    width: 260
    anchors.top: search.bottom
    anchors.right: parent.right
    anchors.bottom: footer.top
    margin: 12 0 10 0

    UILabel
      id: title
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 15
      color: #ffffff
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      phantom: true

    EventShopMuted
      id: subtitle
      text-align: center
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 14
      margin-top: 2

    UIWidget
      id: preview
      height: 88
      image-source: /modules/game_fishing/images/panel
      image-border: 10
      anchors.top: subtitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      phantom: true

      UIItem
        id: item
        size: 48 48
        anchors.centerIn: parent
        virtual: true
        phantom: true

    EventShopText
      id: description
      text-wrap: true
      text-auto-resize: true
      anchors.top: preview.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    EventShopMuted
      id: info
      text-wrap: true
      text-auto-resize: true
      anchors.top: description.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    UIWidget
      id: countBar
      height: 30
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: buy.top
      margin-bottom: 8
      phantom: true

      EventShopMuted
        id: caption
        !text: tr('How many')
        text-auto-resize: true
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      PVBlueButton
        id: plus
        text: +
        size: 30 30
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter

      UILabel
        id: count
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 14
        color: #ffffff
        text-align: center
        width: 44
        anchors.right: plus.left
        anchors.verticalCenter: parent.verticalCenter
        phantom: true

      PVBlueButton
        id: minus
        text: -
        size: 30 30
        anchors.right: count.left
        anchors.verticalCenter: parent.verticalCenter

    PVGreenButton
      id: buy
      height: 38
      ttf-font-size: 14
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom

  UIWidget
    id: offersPanel
    anchors.top: search.bottom
    anchors.left: parent.left
    anchors.right: detail.left
    anchors.bottom: footer.top
    margin: 12 12 10 0
    image-source: /modules/game_fishing/images/panel
    image-border: 10
    padding: 9 10 9 10

    UILabel
      id: title
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 14
      color: #ffffff
      text-auto-resize: true
      anchors.top: parent.top
      anchors.left: parent.left
      phantom: true

    EventShopMuted
      id: count
      text-auto-resize: true
      anchors.right: parent.right
      anchors.verticalCenter: title.verticalCenter

    ScrollablePanel
      id: list
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin: 10 4 0 0
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox
        spacing: 4

    GtsScrollBar
      id: listScroll
      anchors.top: title.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 10

    EventShopMuted
      id: empty
      text-wrap: true
      text-auto-resize: true
      text-align: center
      anchors.top: list.top
      anchors.left: list.left
      anchors.right: list.right
      margin-top: 60

  UIWidget
    id: footer
    height: 32
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    phantom: true

    EventShopMuted
      id: note
      text-auto-resize: true
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter

    PVBlueButton
      id: close
      !text: tr('Close')
      size: 90 32
      ttf-font-size: 13
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_eventshop.close()

EventShopDialog < UIWindow
  size: 380 170
  image-source: /modules/game_dailytasks/images/window
  image-border: 24
  padding: 22 24 22 24
  focusable: true
  @onEscape: modules.game_eventshop.closeDialog()

  UILabel
    id: title
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 17
    color: #ffffff
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  EventShopText
    id: text
    text-wrap: true
    text-auto-resize: true
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  PVGreenButton
    id: confirm
    height: 32
    ttf-font-size: 13
    anchors.left: parent.left
    anchors.right: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-right: 5

  PVBlueButton
    id: cancel
    !text: tr('Cancel')
    height: 32
    ttf-font-size: 13
    anchors.left: parent.horizontalCenter
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 5
    @onClick: modules.game_eventshop.closeDialog()
