// The Ranger radar popup (artwork: scripts/art/radar_ui.py; the frame comes from game_dailytasks,
// the buttons from client_entergame)

RadarBlip < UIButton
  size: 14 14
  anchors.top: parent.top
  anchors.left: parent.left
  focusable: false
  $hover:
    opacity: 0.85

RadarStarBlip < RadarBlip
  size: 18 18

RadarHalo < UIWidget
  size: 44 44
  anchors.top: parent.top
  anchors.left: parent.left
  phantom: true

RadarBadge < UILabel
  image-source: /modules/game_radar/images/badge
  image-border: 5
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 10
  color: #ffffff
  text-auto-resize: true
  text-offset: 0 1
  padding: 2 6 2 6
  height: 16
  phantom: true

RadarPanelTitle < UILabel
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 13
  color: #ffffff
  text-auto-resize: true
  anchors.top: parent.top
  anchors.left: parent.left
  phantom: true

RadarFilterRow < UIButton
  height: 24
  image-source: /modules/game_radar/images/row
  image-border: 6
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 4
  focusable: false
  $hover !disabled:
    image-source: /modules/game_radar/images/row_hover
  $on:
    image-source: /modules/game_radar/images/row_on
  $disabled:
    opacity: 0.55

  UILabel
    id: label
    font: verdana-11px-antialised
    color: #dce6ff
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin: 0 22 0 9
    text-auto-resize: false
    phantom: true

  UIWidget
    id: chevron
    size: 8 8
    image-source: /modules/game_radar/images/chevron
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    phantom: true

  UIWidget
    id: lock
    size: 12 12
    image-source: /modules/game_radar/images/lock
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    phantom: true

RadarCompass < UILabel
  ttf-font: /fonts/ttf/arialb.ttf
  ttf-font-size: 14
  color: #dce6ff
  text-auto-resize: true
  phantom: true

RadarPrint < UIWidget
  size: 32 32
  phantom: true
  focusable: false

  UIWidget
    id: icon
    anchors.fill: parent
    image-source: /modules/game_radar/images/print
    phantom: true

RadarMapArrow < UIWidget
  size: 52 52
  phantom: true
  focusable: false

  UIWidget
    id: icon
    anchors.fill: parent
    image-source: /modules/game_radar/images/arrow
    phantom: true

  UILabel
    id: distance
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #ffd75a
    text-auto-resize: true
    anchors.top: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -8
    phantom: true

RadarWindow < UIWindow
  size: 670 504
  image-source: /modules/game_dailytasks/images/window
  image-border: 24
  padding: 22 26 22 26
  draggable: true
  focusable: true
  @onEscape: modules.game_radar.hide()

  UIWidget
    id: headerIcon
    size: 30 30
    image-source: /modules/game_radar/images/icon_radar
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true

  UILabel
    id: headerTitle
    !text: tr('Ranger Radar')
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 22
    color: #ffffff
    text-auto-resize: true
    anchors.left: headerIcon.right
    anchors.top: parent.top
    margin: -3 0 0 10
    phantom: true

  UILabel
    id: subtitle
    font: verdana-11px-antialised
    color: #96aacd
    text-auto-resize: true
    anchors.left: headerTitle.left
    anchors.top: headerTitle.bottom
    margin-top: 1
    phantom: true

  PVCloseButton
    id: closeButton
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    @onClick: modules.game_radar.hide()

  UIWidget
    id: radar
    size: 400 400
    image-source: /modules/game_radar/images/radar
    anchors.top: headerIcon.bottom
    anchors.left: parent.left
    margin-top: 12

    UIWidget
      id: cone
      anchors.fill: parent
      image-source: /modules/game_radar/images/cone
      phantom: true
      visible: false

    UIWidget
      id: blips
      anchors.fill: parent

    UIWidget
      id: selected
      size: 26 26
      image-source: /modules/game_radar/images/selected
      anchors.top: parent.top
      anchors.left: parent.left
      phantom: true
      visible: false

    UIWidget
      id: center
      size: 40 40
      image-source: /modules/game_radar/images/center
      anchors.centerIn: parent
      phantom: true

      UICreature
        id: creature
        size: 30 30
        anchors.centerIn: parent
        phantom: true

    RadarCompass
      !text: tr('N')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 30

    RadarCompass
      !text: tr('S')
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 30

    RadarCompass
      !text: tr('W')
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 32

    RadarCompass
      !text: tr('E')
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 32

  UIWidget
    id: filters
    image-source: /modules/game_radar/images/panel
    image-border: 10
    anchors.top: radar.top
    anchors.left: radar.right
    anchors.right: parent.right
    margin-left: 14
    height: 196
    padding: 9 10 9 10

    RadarPanelTitle
      !text: tr('Filters')

    RadarFilterRow
      id: all
      anchors.top: prev.bottom
      margin-top: 7

    RadarFilterRow
      id: species
      anchors.top: prev.bottom

    RadarFilterRow
      id: type
      anchors.top: prev.bottom

    RadarFilterRow
      id: rarity
      anchors.top: prev.bottom

    RadarFilterRow
      id: shiny
      anchors.top: prev.bottom

    RadarFilterRow
      id: legendary
      anchors.top: prev.bottom

  UIWidget
    id: target
    image-source: /modules/game_radar/images/panel
    image-border: 10
    anchors.top: filters.bottom
    anchors.left: filters.left
    anchors.right: filters.right
    margin-top: 10
    height: 132
    padding: 9 10 9 10

    RadarPanelTitle
      !text: tr('Target Info')

    UICreature
      id: creature
      size: 48 48
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 4
      phantom: true

    UIWidget
      id: unknown
      size: 18 18
      anchors.centerIn: creature
      phantom: true
      visible: false

    UILabel
      id: name
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 13
      color: #ffffff
      text-auto-resize: false
      anchors.top: creature.top
      anchors.left: creature.right
      anchors.right: parent.right
      margin: 6 0 0 6
      height: 16
      phantom: true

    UIWidget
      id: badges
      anchors.top: name.bottom
      anchors.left: name.left
      anchors.right: parent.right
      margin-top: 4
      height: 16
      phantom: true
      layout:
        type: horizontalBox
        spacing: 3

    UILabel
      id: distance
      font: verdana-11px-antialised
      color: #dce6ff
      text-auto-resize: true
      anchors.top: creature.bottom
      anchors.left: parent.left
      margin-top: 4
      phantom: true

    UILabel
      id: direction
      font: verdana-11px-antialised
      color: #dce6ff
      text-auto-resize: true
      anchors.top: distance.bottom
      anchors.left: parent.left
      margin-top: 2
      phantom: true

    PVBlueButton
      id: stop
      !text: tr('Stop')
      ttf-font-size: 11
      size: 52 22
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      @onClick: modules.game_radar.stop()

  UILabel
    id: message
    font: verdana-11px-antialised
    color: #ff8a80
    text-wrap: true
    text-auto-resize: true
    text-align: center
    anchors.left: filters.left
    anchors.right: filters.right
    anchors.bottom: scan.top
    margin-bottom: 4
    phantom: true

  PVGreenButton
    id: scan
    !text: tr('Scan')
    ttf-font-size: 13
    height: 30
    anchors.left: filters.left
    anchors.right: filters.right
    anchors.bottom: radar.bottom
    @onClick: modules.game_radar.scan()
