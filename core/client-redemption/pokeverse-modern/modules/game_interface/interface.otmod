Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: https://github.com/edubart/otclient
  sandboxed: true
  scripts: [ widgets/uigamemap, widgets/uiitem, widgets/statsbar, gameinterface ]
  load-later:
    - game_walk
    - game_joystick
    - game_shortcuts
    - game_minimap
    - game_healthinfo
    - game_inventory
    - game_mainpanel
    - game_hotkeys
    - game_questlog
    - game_textmessage
    - game_console
    - game_actionbar
    - game_outfit
    - game_skills
    - game_combatcontrols
    - game_containers
    - game_viplist
    - game_battle
    - game_npctrade
    - game_textwindow
    - game_playertrade
    - game_bugreport
    - game_playerdeath
    - game_ruleviolation
    - game_market
    - game_modaldialog
    - game_shaders
    - game_attachedeffects
    - game_cooldown
    - game_healthcircle
    - game_creatureinformation
    - game_pokemoves
    - game_pokebar
    - game_pokedex
    - game_tmchoose
    - game_statusbar
    - game_duelmessage
    - game_tutorial
    - game_effects
    - game_time
    - game_dollcase
    - game_badgecase
    - game_advanceeffect
    - game_slotmachine
    - game_tips
    - game_poll
    - game_lootlist
  @onLoad: init()
  @onUnload: terminate()