DailyText < Label
  font: verdana-11px-antialised
  color: #dfdfdf
  phantom: true

RewardItem < UIItem
  size: 32 32
  virtual: true
  margin-left: 4

DailyReward < UIWidget
  height: 32
  layout:
    type: horizontalBox
    fit-children: true
  phantom: true

DailyTaskRow < UIWidget
  height: 76
  image-source: /modules/game_pokehud/images/panel
  image-border: 9
  padding: 8
  margin-top: 6

  DailyText
    id: title
    font: verdana-11px-rounded
    color: #ffffff
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: claim.left
    margin-right: 6

  ProgressBar
    id: progress
    background-color: #3f9fd8
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: claim.left
    margin-top: 4
    margin-right: 6

  DailyText
    id: money
    color: #f0d070
    text-auto-resize: true
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 9

  DailyReward
    id: items
    anchors.left: money.right
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: -2

  Button
    id: claim
    !text: tr('Claim')
    width: 64
    anchors.top: parent.top
    anchors.right: parent.right

  Button
    id: reroll
    !text: tr('Reroll')
    width: 64
    anchors.top: claim.bottom
    anchors.right: parent.right
    margin-top: 4

DailyTasksWindow < Window
  !text: tr('Daily Tasks')
  size: 380 446
  @onEscape: self:hide()

  UIButton
    id: closeButton
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -29
    margin-right: -10
    @onClick: self:getParent():hide()

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

  DailyText
    id: resets
    color: #a8b4b4
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  UIWidget
    id: tasks
    anchors.top: resets.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 252
    layout:
      type: verticalBox

  HorizontalSeparator
    id: separator
    anchors.top: tasks.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  DailyTaskRow
    id: bonus
    height: 64
    anchors.top: separator.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  DailyText
    id: rerollInfo
    color: #a8b4b4
    text-wrap: true
    anchors.top: bonus.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
