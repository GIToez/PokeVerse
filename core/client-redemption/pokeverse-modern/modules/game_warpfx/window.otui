// The Warp Styles window (window.lua), on the Pokegear window styles: imported when it first opens.
// A card per moment, then a scrolling grid of the styles that fit the chosen one, however many there are.
WarpStylesMoment < UIButton
  size: 102 34
  image-source: /modules/game_pokegear/images/row
  image-border: 11
  image-smooth: true
  $hover:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 0.85
  $on:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 1

  UILabel
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 4 8 0 8
    height: 14
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #c9d3ee
    phantom: true

  UILabel
    id: pick
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin: 1 8 0 8
    height: 12
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4
    phantom: true

WarpStylesTile < UIButton
  size: 102 40
  image-source: /modules/game_pokegear/images/row
  image-border: 11
  image-smooth: true
  $hover:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 0.85
  $on:
    image-source: /modules/game_pokegear/images/row_target
    opacity: 1

  UILabel
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 6 8 0 8
    height: 14
    text-align: center
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 11
    color: #eef2ff
    phantom: true

  UILabel
    id: how
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin: 2 6 0 6
    height: 12
    text-align: center
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 9
    color: #8fa0c4
    phantom: true

  UIWidget
    id: lock
    size: 11 11
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 4 5 0 0
    image-source: /modules/game_trainercard/images/icon_lock
    image-smooth: true
    phantom: true
    visible: false

WarpStylesWindow < PokegearOutfitWindow
  id: warpStylesWindow
  size: 560 404

  PokegearOutfitStage
    id: stage
    anchors.top: header.bottom
    anchors.left: parent.left
    margin-top: 8
    size: 200 250

  UILabel
    id: hint
    anchors.left: stage.left
    anchors.right: stage.right
    anchors.top: stage.bottom
    anchors.bottom: footer.top
    margin-top: 8
    margin-bottom: 4
    text-wrap: true
    text-align: topLeft
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 10
    color: #8fa0c4

  PokegearOutfitLabel
    id: momentsLabel
    anchors.top: header.bottom
    anchors.left: stage.right
    margin-top: 8
    margin-left: 12
    !text: tr('Pick a moment, then a style for it. Click any style to watch it.')

  UIWidget
    id: moments
    anchors.top: momentsLabel.bottom
    anchors.left: momentsLabel.left
    anchors.right: parent.right
    margin-top: 4
    height: 72
    layout:
      type: grid
      cell-size: 102 34
      cell-spacing: 4
      flow: true

  PokegearOutfitLabel
    id: stylesLabel
    anchors.top: moments.bottom
    anchors.left: moments.left
    margin-top: 10

  UIScrollArea
    id: styles
    anchors.top: stylesLabel.bottom
    anchors.left: stylesLabel.left
    anchors.right: parent.right
    anchors.bottom: footer.top
    margin-top: 4
    margin-right: 12
    margin-bottom: 8
    vertical-scrollbar: stylesScroll
    layout:
      type: grid
      cell-size: 102 40
      cell-spacing: 4
      flow: true

  VerticalScrollBar
    id: stylesScroll
    anchors.top: styles.top
    anchors.bottom: styles.bottom
    anchors.left: styles.right
    margin-left: 4
    width: 8
    step: 44
    pixels-scroll: true
