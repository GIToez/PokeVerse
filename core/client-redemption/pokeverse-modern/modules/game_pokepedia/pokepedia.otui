// The Pokepedia window (artwork: scripts/art/pokepedia_ui.py; the Tk styles come from game_dailytasks,
// the Gts list styles from game_gts and the PV styles from client_entergame)

PpField < PVField
  height: 28
  padding: 6 10 6 10

PpArea < UITextEdit
  image-source: /modules/client_entergame/images/field
  image-border: 8
  font: verdana-11px-antialised
  color: #e6ecff
  selection-color: #ffffff
  selection-background-color: #3d6fb8
  padding: 6 8 6 8
  multiline: true
  text-wrap: true
  text-align: topLeft
  $focus:
    image-source: /modules/client_entergame/images/field_focus
  $disabled:
    color: #96aacd

PpList < GtsList
  auto-focus: none
  padding-right: 14

PpSubTab < TkTab
  height: 28
  ttf-font-size: 12
  icon-size: 14 14
  icon-offset-y: 4
  text-offset: 8 0

PpRow < UIWidget
  height: 24
  focusable: true
  background-color: #12203d
  $alternate:
    background-color: #0f1a33
  $hover:
    background-color: #1c3260
  $focus:
    background-color: #3a568c

// a group of rows that opens and closes (Pp.fillTree)
PpGroupRow < UIWidget
  height: 30
  focusable: false
  image-source: /modules/game_dailytasks/images/card
  image-border: 8
  margin-top: 3
  $hover:
    image-source: /modules/game_dailytasks/images/tab_hover
  $on:
    image-source: /modules/game_dailytasks/images/tab_hover

  UIWidget
    id: chevron
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: true

  UIItem
    id: item
    size: 24 24
    virtual: true
    anchors.left: chevron.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true
    visible: false

  UIWidget
    id: icon
    size: 16 16
    anchors.left: chevron.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: true
    visible: false

  UILabel
    id: name
    ttf-font: /fonts/ttf/arialb.ttf
    ttf-font-size: 12
    color: #ffffff
    text-auto-resize: false
    anchors.left: chevron.right
    anchors.right: note.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 34
    phantom: true

  UILabel
    id: note
    font: verdana-11px-antialised
    color: #96aacd
    text-align: right
    text-auto-resize: true
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    phantom: true

// a row inside a group: an icon (image or item), a name and a muted note
PpTreeRow < PpRow
  height: 24

  UIWidget
    id: icon
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: true

  PpCell
    id: name
    anchors.left: icon.right
    anchors.right: note.left
    margin-left: 2

  PpMutedCell
    id: note
    width: 96
    text-align: right
    text-offset: -6 0
    anchors.right: parent.right

PpCell < UILabel
  font: verdana-11px-antialised
  color: #dce6ff
  text-align: left
  text-auto-resize: false
  text-offset: 6 0
  phantom: true
  anchors.top: parent.top
  anchors.bottom: parent.bottom

PpMutedCell < PpCell
  color: #96aacd

PpIconButton < UIButton
  size: 28 28
  image-source: /modules/client_entergame/images/button_blue
  image-border: 8
  icon-align: center
  opacity: 1
  $hover !disabled:
    image-source: /modules/client_entergame/images/button_blue_hover
  $pressed:
    image-source: /modules/client_entergame/images/button_blue_pressed
  $disabled:
    opacity: 0.45

PpLine < UIWidget
  height: 18
  phantom: true

  TkMuted
    id: label
    width: 110
    text-auto-resize: false
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  TkText
    id: value
    text-auto-resize: false
    anchors.left: label.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

PpMapMark < UIWidget
  size: 16 16
  focusable: false

// the map's names (map.lua drawLabels): regions, cities, routes and landmarks
PpMapLabel < UILabel
  phantom: true
  focusable: false
  text-auto-resize: true
  ttf-font: /fonts/ttf/verdana-bold.ttf
  ttf-font-size: 13
  ttf-stroke: 2 #101828
  color: #ffffff

PpMapRegionLabel < PpMapLabel
  ttf-font-size: 24
  ttf-stroke: 3 #101828
  color: #ffe678

PpMapRouteLabel < PpMapLabel
  ttf-font: /fonts/ttf/Verdana-BoldItalic.ttf
  ttf-font-size: 11
  color: #ffeca8

PpMapLandmarkLabel < PpMapLabel
  ttf-font: /fonts/ttf/Verdana-Italic.ttf
  ttf-font-size: 11
  color: #bee6ff

PpRouteDot < UIWidget
  size: 6 6
  image-source: /modules/game_pokepedia/images/route_dot
  phantom: true
  focusable: false

PpHouseTile < UIWidget
  background-color: #ffd75a88
  border-width: 1
  border-color: #ffd75aff
  phantom: true
  focusable: false

// the house on its rendered picture: a light tint, the rooms stay visible
PpHousePictureTile < UIWidget
  background-color: #ffd75a38
  phantom: true
  focusable: false

PpFloorButton < TkTab
  height: 22
  width: 58
  ttf-font-size: 11
  text-offset: 0 0
  text-align: center

PpMinimap < UIMinimap
  clipping: true
  draggable: true
  focusable: false
  color: black
  zoom: 1
  min-zoom: -2
  max-zoom: 4

// map tab

PpPlaceRow < PpRow
  UIWidget
    id: icon
    size: 11 11
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

  PpCell
    id: name
    anchors.left: icon.right
    anchors.right: town.left

  PpMutedCell
    id: town
    width: 96
    text-align: right
    text-offset: -6 0
    anchors.right: parent.right

PpStopRow < PpRow
  height: 28

  UIWidget
    id: icon
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

  PpCell
    id: name
    anchors.left: icon.right
    anchors.right: distance.left

  PpMutedCell
    id: distance
    width: 64
    text-align: right
    text-offset: 0 0
    anchors.right: up.left
    margin-right: 6

  UIButton
    id: up
    size: 14 14
    icon: /modules/game_pokepedia/images/icon_floor_up
    anchors.right: down.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    !tooltip: tr('Move up')

  UIButton
    id: down
    size: 14 14
    icon: /modules/game_pokepedia/images/icon_floor_down
    anchors.right: remove.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    !tooltip: tr('Move down')

  UIButton
    id: remove
    size: 14 14
    icon: /modules/game_pokepedia/images/icon_remove
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    !tooltip: tr('Remove')

PpSidePanel < UIWidget
  anchors.top: placesTab.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  margin-top: 8

MapPage < UIWidget
  UIWidget
    id: side
    width: 300
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom

    PpSubTab
      id: placesTab
      width: 96
      !text: tr('Places')
      anchors.top: parent.top
      anchors.left: parent.left

    PpSubTab
      id: waypointsTab
      width: 108
      !text: tr('Waypoints')
      anchors.top: parent.top
      anchors.left: placesTab.right
      margin-left: 4

    PpSubTab
      id: routeTab
      width: 88
      !text: tr('Route')
      icon: /modules/game_pokepedia/images/icon_route
      icon-offset-x: 8
      anchors.top: parent.top
      anchors.left: waypointsTab.right
      margin-left: 4

    PpSidePanel
      id: placesPanel

      PpField
        id: search
        !placeholder: tr('Search towns and places')
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right

      TkCombo
        id: region
        width: 130
        anchors.top: search.bottom
        anchors.left: parent.left
        margin-top: 6

      TkCombo
        id: kind
        anchors.top: search.bottom
        anchors.left: region.right
        anchors.right: parent.right
        margin-top: 6
        margin-left: 4

      PpList
        id: list
        vertical-scrollbar: listScroll
        anchors.top: kind.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: buttons.top
        margin-top: 6
        margin-bottom: 6

      GtsScrollBar
        id: listScroll
        anchors.top: list.top
        anchors.bottom: list.bottom
        anchors.right: list.right

      UIWidget
        id: buttons
        height: 24
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom

        TkSmallBlueButton
          id: walk
          !text: tr('Walk here')
          width: 96
          anchors.left: parent.left
          anchors.top: parent.top

        TkSmallBlueButton
          id: stop
          !text: tr('Add to route')
          width: 106
          anchors.left: walk.right
          anchors.top: parent.top
          margin-left: 4

        TkSmallBlueButton
          id: save
          !text: tr('Waypoint')
          anchors.left: stop.right
          anchors.right: parent.right
          anchors.top: parent.top
          margin-left: 4

    PpSidePanel
      id: waypointsPanel
      visible: false

      TkMuted
        id: hint
        !text: tr('Right-click the map to add a waypoint. Click one to walk there, right-click it to rename or delete it.')
        text-auto-resize: false
        text-wrap: true
        height: 30
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right

      PpList
        id: list
        vertical-scrollbar: listScroll
        anchors.top: hint.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 6

      GtsScrollBar
        id: listScroll
        anchors.top: list.top
        anchors.bottom: list.bottom
        anchors.right: list.right

    PpSidePanel
      id: routePanel
      visible: false

      TkBold
        id: status
        text-auto-resize: false
        text-wrap: true
        height: 34
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right

      TkTrack
        id: track
        anchors.top: status.bottom
        anchors.left: parent.left
        anchors.right: count.left
        margin-top: 3
        margin-right: 8

      TkText
        id: count
        width: 60
        height: 14
        text-auto-resize: false
        text-align: right
        anchors.right: parent.right
        anchors.top: status.bottom

      PpList
        id: list
        vertical-scrollbar: listScroll
        anchors.top: track.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: hint.top
        margin-top: 8
        margin-bottom: 6

      GtsScrollBar
        id: listScroll
        anchors.top: list.top
        anchors.bottom: list.bottom
        anchors.right: list.right

      TkMuted
        id: hint
        !text: tr('Right-click the map to add stops. Battles and NPC talks pause the route; walking yourself stops it.')
        text-auto-resize: false
        text-wrap: true
        height: 30
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: buttons.top
        margin-bottom: 6

      UIWidget
        id: buttons
        height: 24
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom

        TkClaimButton
          id: start
          !text: tr('Start')
          width: 92
          anchors.left: parent.left
          anchors.top: parent.top

        TkSmallBlueButton
          id: pause
          !text: tr('Pause')
          width: 92
          anchors.left: start.right
          anchors.top: parent.top
          margin-left: 4

        TkSmallRedButton
          id: clear
          !text: tr('Clear')
          anchors.left: pause.right
          anchors.right: parent.right
          anchors.top: parent.top
          margin-left: 4

  TkSection
    id: mapFrame
    padding: 4
    anchors.top: parent.top
    anchors.left: side.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12

    PpMinimap
      id: minimap
      anchors.fill: parent

    PVBlueButton
      id: pokedexButton
      !text: tr('Pokedex')
      width: 104
      height: 28
      ttf-font-size: 12
      icon: /modules/game_pokepedia/images/icon_dex
      icon-size: 16 16
      icon-align: left
      icon-offset-x: 10
      icon-offset-y: 6
      text-offset: 10 0
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 6

    UIWidget
      id: controls
      width: 48
      height: 282
      anchors.top: parent.top
      anchors.right: parent.right
      margin: 6
      phantom: true

      PpIconButton
        id: center
        icon: /modules/game_pokepedia/images/icon_center
        !tooltip: tr('Back to you')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter

      PpIconButton
        id: floorUp
        icon: /modules/game_pokepedia/images/icon_floor_up
        !tooltip: tr('Floor up')
        anchors.top: center.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10

      UILabel
        id: floor
        height: 26
        font: verdana-11px-rounded
        color: #ffd75a
        text-align: center
        background-color: #0b1427cc
        anchors.top: floorUp.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 2
        phantom: true

      PpIconButton
        id: floorDown
        icon: /modules/game_pokepedia/images/icon_floor_down
        !tooltip: tr('Floor down')
        anchors.top: floor.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

      PpIconButton
        id: zoomIn
        text: +
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 16
        color: #cfe2ff
        !tooltip: tr('Zoom in')
        anchors.top: floorDown.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10

      PpIconButton
        id: zoomOut
        text: -
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 16
        color: #cfe2ff
        !tooltip: tr('Zoom out')
        anchors.top: zoomIn.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

      PpIconButton
        id: labels
        text: Aa
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 12
        anchors.top: zoomOut.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10

      PpIconButton
        id: view
        icon-size: 16 16
        visible: false
        anchors.top: labels.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2

    UILabel
      id: coords
      font: verdana-11px-rounded
      color: #ffffff
      background-color: #000000aa
      text-auto-resize: true
      padding: 2 5 2 5
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin: 6
      phantom: true

// houses tab

PpHouseRow < PpRow
  PpCell
    id: name
    anchors.left: parent.left
    anchors.right: size.left

  PpMutedCell
    id: size
    width: 52
    text-align: right
    anchors.right: state.left

  PpCell
    id: state
    width: 110
    text-align: right
    text-offset: -6 0
    anchors.right: parent.right

HousesPage < UIWidget
  UIWidget
    id: side
    width: 380
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom

    PpField
      id: search
      !placeholder: tr('Search houses or owners')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    TkCombo
      id: region
      width: 150
      anchors.top: search.bottom
      anchors.left: parent.left
      margin-top: 6

    TkCombo
      id: state
      width: 104
      anchors.top: region.top
      anchors.left: region.right
      margin-left: 6

    TkCombo
      id: size
      anchors.top: region.top
      anchors.left: state.right
      anchors.right: parent.right
      margin-left: 6

    PVCheckBox
      id: guild
      !text: tr('Guild halls only')
      anchors.top: region.bottom
      anchors.left: parent.left
      margin-top: 8

    TkMuted
      id: count
      anchors.right: parent.right
      anchors.verticalCenter: guild.verticalCenter

    PpList
      id: list
      vertical-scrollbar: listScroll
      anchors.top: guild.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8

    GtsScrollBar
      id: listScroll
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: list.right

  TkSection
    id: details
    padding: 14
    anchors.top: parent.top
    anchors.left: side.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12

    TkMuted
      id: empty
      !text: tr('Pick a house from the list.')
      anchors.centerIn: parent

    UIWidget
      id: content
      anchors.fill: parent
      visible: false

      UIWidget
        id: houseIcon
        size: 18 18
        image-source: /modules/game_pokepedia/images/icon_house
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 2
        phantom: true

      UILabel
        id: name
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 18
        color: #ffffff
        text-auto-resize: false
        height: 22
        anchors.top: parent.top
        anchors.left: houseIcon.right
        anchors.right: preview.left
        margin-left: 8
        margin-right: 12
        phantom: true

      TkMuted
        id: town
        anchors.top: name.bottom
        anchors.left: parent.left
        margin-top: 2

      UIWidget
        id: info
        anchors.top: town.bottom
        anchors.left: parent.left
        anchors.right: preview.left
        margin-top: 10
        margin-right: 12
        height: 120
        layout:
          type: verticalBox
          spacing: 2

      TkSection
        id: preview
        width: 360
        height: 250
        padding: 3
        anchors.top: parent.top
        anchors.right: parent.right

        PpMinimap
          id: minimap
          zoom: 3
          anchors.fill: parent

        UIWidget
          id: floors
          height: 0
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          phantom: true
          layout:
            type: horizontalBox
            spacing: 3

        UIWidget
          id: view
          clipping: true
          background-color: #000000
          anchors.top: floors.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          visible: false

          UIWidget
            id: picture
            anchors.top: parent.top
            anchors.left: parent.left
            phantom: true


      UIWidget
        id: buttons
        height: 26
        anchors.top: preview.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10

        TkClaimButton
          id: buy
          !text: tr('Buy')
          width: 110
          height: 26
          anchors.left: parent.left
          anchors.top: parent.top

        TkSmallRedButton
          id: leave
          !text: tr('Leave house')
          width: 110
          height: 26
          anchors.left: buy.right
          anchors.top: parent.top
          margin-left: 6

        TkSmallBlueButton
          id: walk
          !text: tr('Walk here')
          width: 104
          height: 26
          anchors.right: parent.right
          anchors.top: parent.top

        TkSmallBlueButton
          id: show
          !text: tr('Show on map')
          width: 116
          height: 26
          anchors.right: walk.left
          anchors.top: parent.top
          margin-right: 6

      TkIconText
        id: reason
        icon: /modules/game_dailytasks/images/icon_info
        text-auto-resize: false
        height: 16
        anchors.top: buttons.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6

      UIWidget
        id: access
        anchors.top: reason.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 132
        margin-top: 8

        TkHeading
          id: guestsTitle
          !text: tr('Guests')
          anchors.top: parent.top
          anchors.left: parent.left

        PpArea
          id: guests
          anchors.top: guestsTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          anchors.bottom: saveGuests.top
          margin-top: 4
          margin-right: 6
          margin-bottom: 4

        TkSmallBlueButton
          id: saveGuests
          !text: tr('Save guests')
          width: 120
          anchors.left: parent.left
          anchors.bottom: parent.bottom

        TkHeading
          id: subownersTitle
          !text: tr('Sub-owners')
          anchors.top: parent.top
          anchors.left: parent.horizontalCenter
          margin-left: 6

        PpArea
          id: subowners
          anchors.top: subownersTitle.bottom
          anchors.left: subownersTitle.left
          anchors.right: parent.right
          anchors.bottom: saveSubowners.top
          margin-top: 4
          margin-bottom: 4

        TkSmallBlueButton
          id: saveSubowners
          !text: tr('Save sub-owners')
          width: 140
          anchors.left: subownersTitle.left
          anchors.bottom: parent.bottom

      UIWidget
        id: transfer
        anchors.top: access.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 56
        margin-top: 12

        TkHeading
          id: title
          !text: tr('Transfer')
          anchors.top: parent.top
          anchors.left: parent.left

        PpField
          id: buyer
          !placeholder: tr('Trainer name')
          width: 180
          anchors.top: title.bottom
          anchors.left: parent.left
          margin-top: 4

        PpField
          id: price
          !placeholder: tr('Price')
          width: 120
          anchors.top: buyer.top
          anchors.left: buyer.right
          margin-left: 6

        TkSmallBlueButton
          id: offer
          !text: tr('Offer')
          width: 90
          height: 28
          anchors.top: buyer.top
          anchors.left: price.right
          margin-left: 6

        TkText
          id: pending
          text-auto-resize: false
          anchors.left: parent.left
          anchors.right: cancel.left
          anchors.verticalCenter: buyer.verticalCenter
          margin-right: 8

        TkSmallRedButton
          id: cancel
          !text: tr('Cancel offer')
          width: 120
          anchors.right: parent.right
          anchors.verticalCenter: buyer.verticalCenter

// Pokedex tab

PpDexRow < PpRow
  height: 26

  PpMutedCell
    id: number
    width: 46
    anchors.left: parent.left

  PpCell
    id: name
    anchors.left: number.right
    anchors.right: level.left

  PpCell
