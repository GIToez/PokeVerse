DexPage < UIWidget
  UIWidget
    id: side
    width: 340
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom

    PpField
      id: search
      !placeholder: tr('Search by name or number')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    TkCombo
      id: filter
      width: 170
      anchors.top: search.bottom
      anchors.left: parent.left
      margin-top: 6

    TkMuted
      id: complete
      anchors.right: parent.right
      anchors.verticalCenter: filter.verticalCenter

    PpList
      id: list
      vertical-scrollbar: listScroll
      anchors.top: filter.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8

    GtsScrollBar
      id: listScroll
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: list.right

  TkSection
    id: details
    padding: 14
    anchors.top: parent.top
    anchors.left: side.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12

    TkMuted
      id: empty
      !text: tr('Pick a Pokemon from the list.')
      anchors.centerIn: parent

    UIWidget
      id: content
      anchors.fill: parent
      visible: false

      TkIconFrame
        id: icon
        size: 76 76
        anchors.top: parent.top
        anchors.left: parent.left

      UILabel
        id: name
        ttf-font: /fonts/ttf/arialb.ttf
        ttf-font-size: 20
        color: #ffffff
        text-auto-resize: true
        anchors.top: parent.top
        anchors.left: icon.right
        margin-left: 12
        phantom: true

      TkMuted
        id: tier
        anchors.top: name.bottom
        anchors.left: name.left
        margin-top: 2

      TkBold
        id: level
        anchors.top: tier.bottom
        anchors.left: name.left
        margin-top: 6

      TkTrack
        id: track
        width: 260
        anchors.top: level.bottom
        anchors.left: name.left
        margin-top: 5

      TkText
        id: count
        anchors.left: track.right
        anchors.verticalCenter: track.verticalCenter
        margin-left: 8

      TkMuted
        id: kills
        anchors.verticalCenter: level.verticalCenter
        anchors.left: level.right
        margin-left: 14

      TkSmallBlueButton
        id: trackButton
        !text: tr('Track')
        width: 120
        anchors.top: parent.top
        anchors.right: parent.right

      TkSmallBlueButton
        id: open
        !text: tr('Open in Pokedex')
        width: 140
        anchors.top: trackButton.bottom
        anchors.right: parent.right
        margin-top: 6

      PpKnowledgeCard
        id: stats
        height: 76
        anchors.top: icon.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 12

        UIWidget
          id: values
          height: 34
          anchors.top: title.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          layout:
            type: horizontalBox
            spacing: 24

      PpKnowledgeCard
        id: catching
        height: 92
        anchors.top: stats.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8

        TkText
          id: hint
          anchors.top: title.bottom
          anchors.left: parent.left
          margin-top: 6

        UIWidget
          id: drops
          height: 32
          anchors.top: hint.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4
          layout:
            type: horizontalBox

      PpKnowledgeCard
        id: spawns
        anchors.top: catching.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 8

        PpList
          id: list
          vertical-scrollbar: listScroll
          anchors.top: title.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 6

        GtsScrollBar
          id: listScroll
          anchors.top: list.top
          anchors.bottom: list.bottom
          anchors.right: list.right

