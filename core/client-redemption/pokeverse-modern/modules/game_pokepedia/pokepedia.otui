ItemsPage < UIWidget
  UIWidget
    id: side
    width: 280
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom

    TkHeading
      id: title
      !text: tr('Categories')
      anchors.top: parent.top
      anchors.left: parent.left

    TkMuted
      id: total
      anchors.right: parent.right
      anchors.verticalCenter: title.verticalCenter

    PpList
      id: list
      vertical-scrollbar: listScroll
      anchors.top: title.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: hint.top
      margin-top: 8
      margin-bottom: 8

    GtsScrollBar
      id: listScroll
      anchors.top: list.top
      anchors.bottom: list.bottom
      anchors.right: list.right

    TkMuted
      id: hint
      !text: tr('Shop items are known from the start. Have any other item in your bag or depot, or look at one, to add it.')
      text-auto-resize: false
      text-wrap: true
      height: 44
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom

  TkSection
    id: grid
    padding: 10
    anchors.top: parent.top
    anchors.left: side.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12

    UILabel
      id: name
      ttf-font: /fonts/ttf/arialb.ttf
      ttf-font-size: 15
      color: #ffffff
      text-auto-resize: true
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 4
      phantom: true

    PpField
      id: search
      !placeholder: tr('Search known items')
      width: 220
      anchors.top: parent.top
      anchors.right: parent.right

    ScrollablePanel
      id: items
      vertical-scrollbar: itemsScroll
      anchors.top: search.bottom
      anchors.left: parent.left
      anchors.right: itemsScroll.left
      anchors.bottom: selected.top
      margin-top: 10
      margin-bottom: 8
      layout:
        type: grid
        cell-size: 46 46
        cell-spacing: 6
        flow: true

    GtsScrollBar
      id: itemsScroll
      anchors.top: search.bottom
      anchors.bottom: selected.top
      anchors.right: parent.right
      margin-top: 10
      margin-bottom: 8

    TkText
      id: selected
      text-auto-resize: false
      height: 18
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom

