// Side windows in the PokeVerse look (docs/ui-redesign.md, direction D): a see-through rounded card,
// no header strip, round header buttons. Same widget ids as Redemption's 30-miniwindow.otui, which
// every module anchors to. Images: scripts/art/ui_kit.py. The title font and the gold underline are
// set in UIMiniWindow:setup (corelib.patch), since each module declares its own title label.

MiniWindow < UIMiniWindow
  font: verdana-11px-rounded
  width: 192
  height: 200
  image-source: /images/ui/miniwindow_body
  image-border: 8
  focusable: false
  &minimizedHeight: 22

  $on:
    image-border-bottom: 8

  UIWidget
    id: miniwindowHeader
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    height: 20
    phantom: true

  UIWidget
    id: miniwindowHeaderBevel
    anchors.top: miniwindowHeader.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    height: 0
    phantom: true

    UIWidget
      id: bevelHighlight
      phantom: true

    UIWidget
      id: bevelShadow
      phantom: true

  UIWidget
    id: miniwindowHeaderBorder
    anchors.top: miniwindowHeaderBevel.bottom
    anchors.right: parent.right
    anchors.left: parent.left
    height: 0
    phantom: true

  UIWidget
    id: miniwindowTopBar
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-right: 3
    margin-left: 3
    margin-top: 3
    size: 258 17
    phantom: true

  UIButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 4
    margin-right: 5
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 28 0 14 14

    $hover:
      image-clip: 28 14 14 14

    $pressed:
      image-clip: 28 28 14 14

  UIButton
    id: minimizeButton
    anchors.top: closeButton.top
    anchors.right: closeButton.left
    margin-right: 2
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 14 14

    $hover:
      image-clip: 0 14 14 14

    $pressed:
      image-clip: 0 28 14 14

    $on:
      image-clip: 14 0 14 14

    $on hover:
      image-clip: 14 14 14 14

    $on pressed:
      image-clip: 14 28 14 14

  UIButton
    id: toggleFilterButton
    anchors.top: minimizeButton.top
    anchors.right: minimizeButton.left
    margin-right: 6
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 56 0 14 14

    $hover:
      image-clip: 56 14 14 14

    $pressed:
      image-clip: 56 28 14 14

    $on:
      image-clip: 56 28 14 14

    $on hover:
      image-clip: 56 28 14 14

    $on pressed:
      image-clip: 56 0 14 14

  UIButton
    id: contextMenuButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 2
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 112 0 14 14

    $hover:
      image-clip: 112 14 14 14

    $pressed:
      image-clip: 112 28 14 14

  UIButton
    id: newWindowButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 2
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 126 0 14 14

    $hover:
      image-clip: 126 14 14 14

    $pressed:
      image-clip: 126 28 14 14

    $on:
      image-clip: 126 0 14 14

  UIButton
    id: lockButton
    anchors.top: prev.top
    anchors.right: prev.left
    margin-right: 2
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 98 0 14 14

    $hover:
      image-clip: 98 14 14 14

    $pressed:
      image-clip: 98 28 14 14

    $on:
      image-clip: 84 0 14 14

    $on hover:
      image-clip: 84 14 14 14

    $on pressed:
      image-clip: 84 28 14 14

  VerticalScrollBar
    id: miniwindowScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 22
    margin-right: 3
    margin-bottom: 6
    pixels-scroll: true

    $!on:
      width: 0

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    minimum: 48
    margin-left: 8
    margin-right: 8
    background: #ffffff00

MiniWindowContents < ScrollablePanel
  id: contentsPanel
  anchors.top: miniwindowHeader.bottom
  anchors.left: parent.left
  anchors.right: miniwindowScrollBar.left
  anchors.bottom: parent.bottom
  margin-left: 4
  margin-bottom: 5
  margin-top: 2
  margin-right: 2
  vertical-scrollbar: miniwindowScrollBar
  always-show-vertical-scrollbar: true

PhantomMiniWindow < UIMiniWindow
  draggable: true
  phantom: false
  focusable: false
  &moveOnlyToMain: true

  UIWidget
    image-source: /images/ui/miniwindow_body
    image-border: 8
    anchors.fill: parent
    phantom: true

  UIWidget
    id: miniwindowTopBar
    phantom: true

  UIButton
    id: closeButton
    phantom: true

GameButtonsWindow < MiniWindow
  height: 26
