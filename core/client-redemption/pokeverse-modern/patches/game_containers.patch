 end
 
 function onContainerOpen(container, previousContainer)
+    -- PokeVerse: in the Pokegear layout the Bag window shows the bag and the bags in it
+    local pokegear = modules.game_pokegear
+    if pokegear and pokegear.claimsContainer and pokegear.claimsContainer(container) then
+        if previousContainer then
+            destroy(previousContainer)
+        end
+        return
+    end
+    -- a container the Bag had shown, now opened here, has no window to reuse
+    if previousContainer and not previousContainer.window then
+        previousContainer = nil
+    end
     local containerWindow
     if previousContainer then
         containerWindow = previousContainer.window
