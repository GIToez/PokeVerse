+                       shield == ShieldYellowNoSharedExp or
+                       shield == ShieldBlue or
+                       shield == ShieldBlueNoSharedExpBlink or
+                       shield == ShieldBlueSharedExp or
+                       shield == ShieldYellowNoSharedExpBlink)
+end
+
+-- party members and the Pokemon they have out
+local function isPartyCreature(creature, localPlayer)
+    if creature:isPlayer() then
+        return isPartyPlayer(creature)
+    end
+    local pokehud = modules.game_pokehud
+    local ownerId = pokehud and pokehud.Nameplates and pokehud.Nameplates.getSummonOwner(creature:getId())
+    if not ownerId or ownerId == localPlayer:getId() then
+        return false
+    end
+    local owner = g_map.getCreatureById(ownerId)
+    return owner ~= nil and owner:isPlayer() and isPartyPlayer(owner)
+end
