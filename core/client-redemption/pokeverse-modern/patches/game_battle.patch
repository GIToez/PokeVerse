+-- PokeVerse: with the battle list closed its rows stop updating, so Tab cycles what is on screen instead
+local function attackNextOnScreen(previous)
+    local player = g_game.getLocalPlayer()
+    local position = player and player:getPosition()
+    if not position then
+        return false
+    end
+    local playerId = player:getId()
+    local candidates = {}
+    for _, creature in ipairs(getCreaturesAroundPlayer()) do
+        if not creature:isLocalPlayer() and creature:isAttackable() and creature:canBeSeen()
+            and creature:getMasterId() ~= playerId then
+            local pos = creature:getPosition()
+            candidates[#candidates + 1] = { creature = creature,
+                distance = math.max(math.abs(pos.x - position.x), math.abs(pos.y - position.y)) }
+        end
+    end
+    if #candidates == 0 then
+        return false
+    end
+    table.sort(candidates, function(a, b)
+        if a.distance ~= b.distance then
+            return a.distance < b.distance
+        end
+        return a.creature:getId() < b.creature:getId()
+    end)
+    local current = g_game.getAttackingCreature()
+    local index = 0
+    for i, entry in ipairs(candidates) do
+        if current and entry.creature:getId() == current:getId() then
+            index = i
+            break
+        end
+    end
+    if previous then
+        index = index <= 1 and #candidates or index - 1
+    else
+        index = index % #candidates + 1
+    end
+    g_game.attack(candidates[index].creature)
+    return true
+end
