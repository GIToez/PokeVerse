+-- PokeVerse: Pokemon names end in their level ("Rattata [5]"); trainers and NPCs have none
+local function creatureLevel(creature)
+    return tonumber(creature:getName():match(' %[(%d+)%]$')) or 0
+end
+
+-- PokeVerse: the rows that stay on top whatever the sort, in order: the trainer's own Pokemon, then
+-- the one the Ranger radar is tracking
+local function pinnedButtons(instance)
+    local pinned = {}
+    for _, button in pairs(instance.battleButtons) do
+        if button.creature and button.creature:isLocalPlayerSummon() then
+            pinned[#pinned + 1] = button
+        end
+    end
+    local nameplates = modules.game_pokehud and modules.game_pokehud.Nameplates
+    local trackedId = nameplates and nameplates.getTracked and nameplates.getTracked()
+    local tracked = trackedId and instance.battleButtons[trackedId]
+    if tracked and not (tracked.creature and tracked.creature:isLocalPlayerSummon()) then
+        pinned[#pinned + 1] = tracked
+    end
+    return pinned
+end
