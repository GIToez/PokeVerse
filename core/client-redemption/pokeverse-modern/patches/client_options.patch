+            'autoChaseOverride', 'moveStack', 'openMaximized', 'displayText', 'showPing', 'hotkeyDelay',
+            'walkTurnDelay', 'walkTeleportDelay', 'walkStairsDelay' })
+        g_settings.set('pokeverseLayoutVersion', 2)
+        g_settings.save()
