     [InventorySlotAmmo] = function(ui) return ui.tools, ui.tools.tools end
 }
 
+-- the Order, Pokedex and Badges sprites have their name drawn under the picture; their tiles show the
+-- picture cut above it (scripts/art/inventory_tiles.py) and a label, over the item kept for clicks and drags
+local TILE_ICONS = {
+    [645] = 'inv-order', [11597] = 'inv-order',     -- server 7730, 13206
+    [11242] = 'inv-pokedex',                        -- server 12281
+    [11241] = 'inv-badges-kanto',                   -- server 12280
+    [17270] = 'inv-badges-orange',                  -- server 18623
+}
+
+local function updateTile(slotPanel, item)
+    local icon = slotPanel:getChildById('pokeverseTileIcon')
+    if not icon then
+        return
+    end
+    local name = item and TILE_ICONS[item:getId()]
+    slotPanel.item:setSize(slotPanel:getSize())
+    slotPanel.item:setOpacity(name and 0 or 1)
+    icon:setVisible(name ~= nil)
+    if name then
+        icon:setImageSource('/images/pokeverse-ui/' .. name)
+    end
+    local label = slotPanel:getChildById('pokeverseTileLabel')
+    label:setText(tr(slotPanel.pokeverseTile))
+    label:setVisible(name ~= nil)
+end
+
 local function isPlayerMonk()
     local player = g_game.getLocalPlayer()
     if not player then
