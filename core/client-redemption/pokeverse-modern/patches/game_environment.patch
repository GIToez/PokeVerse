+-- PokeVerse: the areas were made for the old map, which lies 2351 tiles further west
+local MAP_OFFSET_X = 2351
+local shiftedAreas = {}
+local function shiftArea(area)
+    if (shiftedAreas[area]) then
+        return
+    end
+    shiftedAreas[area] = true
+    area[DATA_INDEX.X] = area[DATA_INDEX.X] + MAP_OFFSET_X
+    area.fromPos.x = area.fromPos.x + MAP_OFFSET_X
+    area.toPos.x = area.toPos.x + MAP_OFFSET_X
+    for _, closeArea in ipairs(area.closePriorities or {}) do
+        shiftArea(closeArea)
+    end
+end
+for i = 1, #SOUNDS do
+    shiftArea(SOUNDS[i])
+end
+shiftedAreas = nil
+
+-- PokeVerse: areas of the map parts the old map does not have
+dofile("sounds_pokeverse.lua")
+for _, area in ipairs(SOUNDS_POKEVERSE) do
+    SOUNDS[#SOUNDS + 1] = area
+end
