 function nextViewMode()
     setupViewMode((currentViewMode + 1) % 3)
+    g_settings.set('pokeverseViewMode', currentViewMode)
+end
+
+-- PokeVerse: the side panels can be dragged wider by their inner edge (the minimap grows with the right one).
+local SIDE_PANEL_MIN = 176
+local SIDE_PANEL_MAX = 360
+local sidePanelHandles = {}
+
+local function sidePanelWidthKey(side)
+    return side == 'right' and 'pokeverseRightPanelWidth' or 'pokeverseLeftPanelWidth'
+end
+
+local function setSidePanelWidth(side, width)
+    width = math.floor(math.min(math.max(width, SIDE_PANEL_MIN), SIDE_PANEL_MAX))
+    if side == 'right' then
+        gameRightPanel:setWidth(width)
+        gameMainRightPanel:setWidth(width)
+    elseif gameLeftPanel:isOn() then
+        gameLeftPanel:setWidth(width)
+    end
+    layoutFloatingChat()
+    return width
+end
+
+function applySidePanelWidths()
+    if g_platform.isMobile() then
+        return
+    end
+    for _, side in ipairs({ 'right', 'left' }) do
+        setSidePanelWidth(side, g_settings.getNumber(sidePanelWidthKey(side), SIDE_PANEL_MIN))
+        local handle = sidePanelHandles[side]
+        if handle then
+            handle:setVisible(side == 'right' or gameLeftPanel:isOn())
+        end
+    end
+end
+
+function createSidePanelHandles()
+    if g_platform.isMobile() then
+        return
+    end
+    for _, side in ipairs({ 'right', 'left' }) do
+        local panel = side == 'right' and gameRightPanel or gameLeftPanel
+        local handle = g_ui.createWidget('UIWidget', gameRootPanel)
+        handle:setId(side .. 'SidePanelHandle')
+        handle:setWidth(6)
+        handle:setFocusable(false)
+        handle:setTooltip(tr('Drag to resize, double-click to reset'))
+        handle:addAnchor(AnchorTop, 'parent', AnchorTop)
+        handle:addAnchor(AnchorBottom, 'parent', AnchorBottom)
+        if side == 'right' then
+            handle:addAnchor(AnchorRight, panel:getId(), AnchorLeft)
+        else
+            handle:addAnchor(AnchorLeft, panel:getId(), AnchorRight)
+        end
+        handle.onHoverChange = function(self, hovered)
+            self:setBackgroundColor(hovered and '#ffffff30' or '#00000000')
+            if hovered then
+                g_mouse.pushCursor('horizontal')
+            else
+                g_mouse.popCursor('horizontal')
+            end
+        end
+        handle.onMousePress = function(self, mousePos, button)
+            self.dragging = button == MouseLeftButton
+            return self.dragging
+        end
+        handle.onMouseMove = function(self, mousePos)
+            if not self.dragging then
+                return false
+            end
+            if side == 'right' then
+                setSidePanelWidth(side, gameRootPanel:getX() + gameRootPanel:getWidth() - mousePos.x)
+            else
+                setSidePanelWidth(side, mousePos.x - gameRootPanel:getX())
+            end
+            return true
+        end
+        handle.onMouseRelease = function(self)
+            if not self.dragging then
+                return false
+            end
+            self.dragging = false
+            g_settings.set(sidePanelWidthKey(side), panel:getWidth())
+            return true
+        end
+        handle.onDoubleClick = function(self)
+            g_settings.set(sidePanelWidthKey(side), setSidePanelWidth(side, SIDE_PANEL_MIN))
+            return true
+        end
+        sidePanelHandles[side] = handle
+    end
 end
 
