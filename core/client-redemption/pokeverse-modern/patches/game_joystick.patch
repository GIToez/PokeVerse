+local function setKeypadMousePos(widget, pos)
+  keypadMousePos = {x=(pos.x - widget:getPosition().x) / widget:getWidth(), 
+                    y=(pos.y - widget:getPosition().y) / widget:getHeight()}
+end
+
+local function stopWalking()
+  removeEvent(keypadUpdateEvent)
+  keypadUpdateEvent = nil
+  keypad.pointer:setMarginTop(0)
+  keypad.pointer:setMarginLeft(0)
+  if moveListener then
+    moveListener(nil)
+  end
+end
+
 function onKeypadTouchPress(widget, pos, button)
   if button ~= MouseLeftButton then return false end
 
-  keypadMousePos = {x=(pos.x - widget:getPosition().x) / widget:getWidth(), 
-                    y=(pos.y - widget:getPosition().y) / widget:getHeight()}
+  setKeypadMousePos(widget, pos)
+  pressPoint = { x = pos.x, y = pos.y }
+  removeEvent(holdEvent)
+  holdEvent = scheduleEvent(function()
+    holdEvent = nil
+    local now = g_window.getMousePosition()
+    if g_mouse.isPressed(MouseLeftButton) and inMiddle()
+        and math.abs(now.x - pressPoint.x) <= HOLD_SLOP and math.abs(now.y - pressPoint.y) <= HOLD_SLOP then
+      stopWalking()
+      local at = keypad:getPosition()
+      grabOffset = { x = now.x - at.x, y = now.y - at.y }
+      keypad:breakAnchors()
+      keypad:setPosition(at)
+      setMoving(true)
+    end
+  end, HOLD_TO_MOVE_MS)
 
   firstStep = true
