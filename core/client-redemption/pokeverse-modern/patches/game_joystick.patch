 local firstStep = true
 local moveListener
 
+-- PokeVerse: hold the middle of the pad still to pick it up, drag it and let go; the spot is kept as a
+-- fraction of the free screen so it stays put across rotations and resolutions
+local HOLD_TO_MOVE_MS = 600
+local HOLD_SLOP = 12
+local POSITION_KEY = 'joystickPos'
+local holdEvent
+local pressPoint
+local moving = false
+local grabOffset
+
+local function inMiddle()
+  return math.abs(keypadMousePos.x - 0.5) < 0.15 and math.abs(keypadMousePos.y - 0.5) < 0.15
+end
+
+local function clampPosition(x, y)
+  local area = overlay:getRect()
+  x = math.max(area.x, math.min(area.x + area.width - keypad:getWidth(), x))
+  y = math.max(area.y, math.min(area.y + area.height - keypad:getHeight(), y))
+  return x, y
+end
+
+local function applySavedPosition()
+  local saved = g_settings.getNode(POSITION_KEY)
+  if type(saved) ~= 'table' or not tonumber(saved.x) or not tonumber(saved.y) then
+    return
+  end
+  local area = overlay:getRect()
+  local x = area.x + tonumber(saved.x) * math.max(0, area.width - keypad:getWidth())
+  local y = area.y + tonumber(saved.y) * math.max(0, area.height - keypad:getHeight())
+  keypad:breakAnchors()
+  keypad:setPosition({ x = math.floor(x), y = math.floor(y) })
+end
+
+local function savePosition()
+  local area = overlay:getRect()
+  local freeWidth = math.max(1, area.width - keypad:getWidth())
+  local freeHeight = math.max(1, area.height - keypad:getHeight())
+  local pos = keypad:getPosition()
+  g_settings.setNode(POSITION_KEY, { x = (pos.x - area.x) / freeWidth, y = (pos.y - area.y) / freeHeight })
+  g_settings.save()
+end
+
+local function setMoving(value)
+  moving = value
+  keypad:setOn(value)
+  keypad:setImageColor(value and '#ffd75a' or '#ffffff')
+end
+
+function resetPosition()
+  g_settings.remove(POSITION_KEY)
+  g_settings.save()
+  if keypad then
+    keypad:breakAnchors()
+    keypad:addAnchor(AnchorBottom, 'parent', AnchorBottom)
+    keypad:addAnchor(AnchorLeft, 'parent', AnchorLeft)
+  end
+end
+
 function init()
   if not g_platform.isMobile() then return end
 
@@ -16,6 +74,11 @@
     onMouseRelease = onKeypadTouchRelease,  
