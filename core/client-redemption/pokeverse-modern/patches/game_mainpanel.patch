+-- PokeVerse top bar order in the extended view, in groups: adventure, side panels, system
+local topBarGroups = {
+    { 'pokepediaButton', 'dailyTasksButton', 'questLogButton', 'dailyLoginButton', 'pokepediaTrackerButton' },
+    { 'miniMap', 'inventory', 'skillsButton', 'battleButton', 'vipListButton' },
+    { 'hotkeysWindowButton', 'audioButton', 'optionsButton', 'terminalButton', 'logoutButton' },
+}
+
+local function sortTopBar(panel)
+    local rank = {}
+    for g, ids in ipairs(topBarGroups) do
+        for i, id in ipairs(ids) do
+            rank[id] = g * 100 + i
+        end
+        if g > 1 then
+            local sepId = 'topBarSeparator' .. g
+            if not panel:getChildById(sepId) then
+                local sep = g_ui.createWidget('UIWidget', panel)
+                sep:setId(sepId)
+                sep:setSize({ width = 1, height = 16 })
+                sep:setMarginTop(2)
+                sep:setBackgroundColor('#2f4878')
+                sep:setPhantom(true)
+            end
+            panel:getChildById(sepId):show()
+            rank[sepId] = g * 100
+        end
+    end
+    rank['Store shop'] = 1000
+    local children = panel:getChildren()
+    local position = {}
+    for i, child in ipairs(children) do
+        position[child] = i
+    end
+    table.sort(children, function(a, b)
+        local ra, rb = rank[a:getId()] or 900, rank[b:getId()] or 900
+        if ra ~= rb then
+            return ra < rb
+        end
+        return position[a] < position[b]
+    end)
+    panel:reorderChildren(children)
+end
