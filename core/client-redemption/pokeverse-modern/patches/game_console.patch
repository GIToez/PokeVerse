+-- Tabs created while the bar had no width yet were pushed into its overflow lists out of order, which left Local Chat
+-- hidden behind channels the server opens at login. Local Chat, NPCs and Server Log go first, so later tabs are added
+-- after them and NPCs stays visible on a narrow console.
+function resetTabOrder()
+    local npcTab = consoleTabBar:getTab('NPCs')
+    if not npcTab then
+        npcTab = addTab('NPCs', false)
+        npcTab.npcChat = true
+    end
+
+    local ordered = { defaultTab, npcTab, serverTab }
+    for _, list in ipairs({ consoleTabBar.preTabs, consoleTabBar.tabs, consoleTabBar.postTabs }) do
+        for _, tab in ipairs(list) do
+            if not table.find(ordered, tab) then
+                ordered[#ordered + 1] = tab
+            end
+        end
+    end
+    for _, tab in ipairs(ordered) do
+        tab:setVisible(false)
+    end
+    consoleTabBar.preTabs, consoleTabBar.tabs, consoleTabBar.postTabs = {}, {}, ordered
+    consoleTabBar.onGeometryChange()
+end
+
