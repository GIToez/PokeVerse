+-- PokeVerse: the letter keys and the numpad are Keybinds (Settings > Controls), so they can be
+-- changed or cleared for hotkeys; the letters are only bound with chat off. The arrows and
+-- Ctrl+arrows above stay fixed.
+local KEYBIND_CATEGORY = 'Movement'
+
+-- action, direction, key with chat off, second key (both chat modes)
+local walkKeybinds = {
+    { 'Walk north',      North,     'W', 'Numpad8' },
+    { 'Walk east',       East,      'D', 'Numpad6' },
+    { 'Walk south',      South,     'S', 'Numpad2' },
+    { 'Walk west',       West,      'A', 'Numpad4' },
+    { 'Walk north-east', NorthEast, '',  'Numpad9' },
+    { 'Walk north-west', NorthWest, '',  'Numpad7' },
+    { 'Walk south-east', SouthEast, '',  'Numpad3' },
+    { 'Walk south-west', SouthWest, '',  'Numpad1' },
+}
+local NUMPAD_MIGRATED_SETTING = 'pokeverse-numpad-keybinds'
+
+local turnKeybinds = {
+    { 'Turn north', North, 'Ctrl+W' },
+    { 'Turn east',  East,  'Ctrl+D' },
+    { 'Turn south', South, 'Ctrl+S' },
+    { 'Turn west',  West,  'Ctrl+A' },
+}
+
+local floorKeybinds = {
+    { 'Fly up a floor (/up)',     '/up',   'Q' },
+    { 'Fly down a floor (/down)', '/down', 'Z' },
+}
+
+local function chatOffKey(key)
+    return { [CHAT_MODE.ON] = '', [CHAT_MODE.OFF] = key }
+end
+
 WalkController = Controller:new()
 
