[Desktop Entry]
Type=Application
Name=PokeVerse
Comment=Play PokeVerse
Exec=sh -c "d=; [ -n \\"\\$1\\" ] && d=\\$(dirname \\"\\$1\\"); [ -f \\"\\$d/PokeVerse.sh\\" ] || d=\\$(sed -n \\"s/^Path=//p\\" \\"\\${XDG_DATA_HOME:-\\$HOME/.local/share}/applications/pokeverse.desktop\\" 2>/dev/null); [ -f \\"\\$d/PokeVerse.sh\\" ] || d=\\$(dirname \\"\\$(find \\"\\$HOME\\" -maxdepth 4 -path \\"*/PokeVerse/PokeVerse.sh\\" 2>/dev/null | head -n 1)\\"); exec sh \\"\\$d/PokeVerse.sh\\"" PokeVerse %k
Icon=pokeverse
Terminal=false
Categories=Game;
