AdvanceGroup < UIWidget
  width: 250
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    spacing: 3
    fit-children: true

AdvanceCard < UIWidget
  size: 250 72
  image-source: /modules/game_advanceeffect/images/popup-card
  image-border: 12
  phantom: true
  focusable: false

  UIWidget
    id: disc
    size: 60 60
    image-source: /modules/game_advanceeffect/images/popup-disc
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    phantom: true

    UIWidget
      id: picture
      size: 64 64
      anchors.centerIn: parent
      phantom: true
      visible: false

    UICreature
      id: creature
      size: 50 50
      anchors.centerIn: parent
      creature-center: true
      phantom: true
      visible: false

    Item
      id: moveIcon
      size: 34 34
      anchors.centerIn: parent
      border-width: 0
      padding: 0
      image-source: ~
      phantom: true
      visible: false

    UIWidget
      id: ring
      image-source: /modules/game_advanceeffect/images/popup-ring
      anchors.fill: parent
      phantom: true

  UIWidget
    id: badge
    size: 20 20
    anchors.right: disc.right
    anchors.bottom: disc.bottom
    margin-right: -3
    margin-bottom: -2
    phantom: true

  UILabel
    id: title
    font: verdana-11px-rounded
    color: #e2b23e
    anchors.top: parent.top
    anchors.left: disc.right
    anchors.right: parent.right
    margin-top: 11
    margin-left: 12
    margin-right: 10
    phantom: true

  UILabel
    id: subtitle
    font: verdana-11px-rounded
    color: #c3cfcf
    anchors.top: title.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 1
    phantom: true

  UILabel
    id: value
    font: sans-bold-16px
    color: #ffffff
    anchors.top: subtitle.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 1
    phantom: true

AdvanceFeatureRow < UIWidget
  size: 250 42
  image-source: /modules/game_advanceeffect/images/popup-card
  image-border: 12
  phantom: true
  focusable: false

  UIWidget
    id: icon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 20
    phantom: true

  UILabel
    id: title
    font: verdana-11px-rounded
    color: #e2b23e
    !text: tr('New Feature')
    anchors.top: parent.top
    anchors.left: icon.right
    anchors.right: parent.right
    margin-top: 6
    margin-left: 18
    margin-right: 10
    phantom: true

  UILabel
    id: value
    font: verdana-11px-rounded
    color: #ffffff
    anchors.top: title.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 2
    phantom: true

UIWidget
  id: advanceColumn
  width: 250
  anchors.top: gameMapPanel.verticalCenter
  anchors.horizontalCenter: gameMapPanel.horizontalCenter
  margin-top: 44
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    spacing: 6
    fit-children: true
