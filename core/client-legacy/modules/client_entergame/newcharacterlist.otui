Character < Creature
  fixed-creature-size: true
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 30
  margin-left: -10
  image-source: ~
  phantom: true

CharacterPokemon < UIWidget
  image-source: ~
  size: 50 54

CharacterWidget < UIWidget
  image-source: /images/trainerCards/trainer
  background-color: alpha
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()
  opacity: 0.6

  $focus:
    opacity: 1.0

  Label
    id: name
    color: #aaaaaa
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    text-offset: 2 0
    text-align: center
    margin-top: 8
    margin-left: 5
    phantom: true

    $on:
      color: #ffffff

  Label
    visible: false
    id: worldName
    color: #aaaaaa
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 5
    margin-top: 8
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    &baseText: 'Server %s'

    $on:
      color: #ffffff

  Label
    id: level
    color: #5C5C5C
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 40
    font: sans-bold-16px
    text-align: center
    background-color: alpha
    width: 75
    phantom: true

    $on:
      color: #7F7F7F

  CharacterPokemon
    id: pokemon1
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 30
    margin-left: 78

  CharacterPokemon
    id: pokemon2
    anchors.top: pokemon1.top
    anchors.left: pokemon1.right

  CharacterPokemon
    id: pokemon3
    anchors.top: pokemon1.top
    anchors.left: pokemon2.right

  CharacterPokemon
    id: pokemon4
    anchors.top: pokemon1.bottom
    anchors.left: pokemon1.left

  CharacterPokemon
    id: pokemon5
    anchors.top: pokemon4.top
    anchors.left: pokemon4.right

  CharacterPokemon
    id: pokemon6
    anchors.top: pokemon4.top
    anchors.left: pokemon5.right

CreateCharacterCard < UIWidget
  background-color: #00000050
  border-width: 1
  border-color: #ffffff40
  opacity: 0.8

  $focus:
    opacity: 1.0
    border-color: #ffffffa0

  Label
    id: plus
    !text: '+'
    font: sans-bold-16px
    color: #ffffff
    text-auto-resize: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.verticalCenter
    phantom: true

  Label
    !text: tr('Create character')
    font: verdana-11px-monochrome
    color: #ffffff
    text-auto-resize: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.verticalCenter
    margin-top: 6
    phantom: true

  Label
    id: slots
    font: verdana-11px-monochrome
    color: #aaaaaa
    text-auto-resize: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 10
    phantom: true

MainWindow
  id: charactersWindow
  !text: tr('Select Character')
  size: 540 300
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    local function list() return self:getChildById('characters') end
    g_keyboard.bindKeyPress('Up', function() list():focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Down', function() list():focusNextChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Left', function() list():focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Right', function() list():focusNextChild(KeyboardFocusReason) end, self)

  ScrollableFlatPanel
    id: characters
    anchors.top: parent.top
    anchors.bottom: accountStatusCaption.top
    anchors.horizontalCenter: parent.horizontalCenter
    width: 494
    margin-bottom: 6
    padding: 1
    layout:
      type: grid
      cell-size: 245 158
      cell-spacing: 4
      flow: true
    vertical-scrollbar: characterListScrollBar
    auto-focus: first
    focusable: false

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: characters.top
    anchors.bottom: characters.bottom
    anchors.left: characters.right
    step: 162
    pixels-scroll: true
    visible: false

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    anchors.left: parent.left
    anchors.bottom: separator.top
    margin-bottom: 5

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    anchors.left: accountStatusCaption.right
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-left: 5
    margin-bottom: 5
    text-auto-resize: true

    $on:
      color: #FF0000

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonOk.top
    margin-bottom: 8

  Button
    id: buttonDeleteCharacter
    !text: tr('Delete')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 70
    @onClick: CharacterList.deleteCharacter()

  Button
    id: buttonDonate
    !text: tr('Donate')
    !tooltip: tr('Opens the PokeVerse Discord server')
    anchors.left: buttonDeleteCharacter.right
    anchors.bottom: parent.bottom
    width: 70
    margin-left: 8
    @onClick: CharacterList.openDonate()

  Button
    id: buttonOk
    !text: tr('Play')
    width: 70
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 8
    @onClick: CharacterList.doLogin()

  Button
    id: buttonCancel
    !text: tr('Cancel')
    width: 70
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.hide(true)
