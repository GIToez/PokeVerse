Panel
  focusable: false
  image-source: ~
  size: 50 66

  DexSectionTitle
    !text: tr('Information')

  MultilineTextEdit
    id: aaaText
    image-source: ~
    color: #e7e7e7
    height: 64
    margin-top: 45
    anchors.fill: parent
    anchors.right: aaaTextScroll.left
    vertical-scrollbar: aaaTextScroll
    text-wrap: true
    editable: false
    cursor-visible: false

  VerticalScrollBar
    image-source: ~
    id: aaaTextScroll
    margin-top: 40
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 32
    pixels-scroll: true
