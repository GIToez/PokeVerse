CraftSlot < UIItem
  size: 37 37
  padding: 1
  image-source: /modules/game_craft/images/slot
  font: lucida-11px-rounded
  color: white
  virtual: true

CraftRecipeItem < UIItem
  size: 30 30
  padding: 1
  image-source: /modules/game_craft/images/recipe_slot
  font: lucida-11px-rounded
  color: white
  virtual: true

CraftProgressBar < UIProgressBar
  height: 3
  background-color: #2dabf9
  image-source: ~

CraftSpeedUpWindow < MainWindow
  id: speedUpWindow
  !text: tr('Speed up')
  size: 380 140
  @onEscape: self:hide()
  @onEnter: modules.game_craft.speedUpItem()

  Label
    id: text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 50
    text-align: center
    text-wrap: true

  Button
    id: confirm
    !text: tr('Speed up')
    width: 90
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    @onClick: modules.game_craft.speedUpItem()

  Button
    id: cancel
    !text: tr('Cancel')
    width: 90
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: self:getParent():hide()

CraftCreateWindow < UIWindow
  id: createWindow
  size: 340 304
  anchors.centerIn: parent
  image-source: images/interface/window_fabricar
  font: verdana-11px-rounded
  @onEscape: self:hide()

  CraftSlot
    id: item
    size: 45 45
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 30
    margin-left: 20

  Label
    id: name
    anchors.top: item.top
    anchors.left: item.right
    font: terminus-14px-bold
    margin-top: 15
    margin-left: 10
    text-auto-resize: true

  Label
    id: label
    anchors.top: item.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: 17
    !text: tr('Required materials')
    text-auto-resize: true

  UIWidget
    id: recipe
    size: 302 74
    anchors.top: label.bottom
    anchors.left: label.left
    margin-top: 5
    layout:
      type: grid
      cell-size: 36 36
      num-columns: 8
      num-lines: 2
      cell-spacing: 2

  Label
    id: labelTotal
    height: 34
    anchors.top: recipe.bottom
    anchors.left: recipe.left
    anchors.right: parent.right
    margin-top: 6
    text-align: topLeft
    text-wrap: true

  HorizontalScrollBar
    id: qntScrollBar
    anchors.top: labelTotal.bottom
    anchors.left: recipe.left
    anchors.right: recipe.right
    step: 1
    minimum: 1
    maximum: 100
    show-value: true
    @onValueChange: modules.game_craft.refreshCreateWindow()

  Button
    id: create
    !text: tr('Craft')
    width: 110
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 14
    margin-left: 40
    @onClick: modules.game_craft.doCreateItem()

  Button
    id: cancel
    !text: tr('Cancel')
    width: 110
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 14
    margin-right: 40
    @onClick: self:getParent():hide()

CraftItemWidget < UIWidget
  size: 594 101
  image-source: images/interface/window_craft
  focusable: true

  CraftProgressBar
    id: progressBar
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 9
    margin-left: 80
    margin-right: 16

  UIWidget
    size: 85 87
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 7
    margin-left: 35
    image-source: images/interface/slots
    phantom: true

  CraftSlot
    id: item
    size: 40 40
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 28
    margin-left: 54
    phantom: true

  UIWidget
    id: progressIcon
    size: 77 78
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    opacity: 0.8
    margin-bottom: 14
    margin-left: 37
    image-source: images/progressIconAnimated
    visible: false
    phantom: true

  Label
    id: name
    anchors.top: parent.top
    anchors.left: item.right
    font: terminus-14px-bold
    margin-top: 20
    margin-left: 30
    text-auto-resize: true
    phantom: true

  Label
    id: timedesc
    anchors.top: parent.top
    anchors.left: name.right
    font: terminus-14px-bold
    color: white
    margin-top: 20
    margin-left: 8
    text-auto-resize: true
    phantom: true

  Label
    id: desc
    size: 300 50
    anchors.top: name.bottom
    anchors.left: item.right
    margin-top: 6
    margin-left: 33
    text-align: topLeft
    text-wrap: true
    font: verdana-11px-rounded
    phantom: true

  UIWidget
    id: levelWindow
    size: 29 29
    image-source: images/interface/level_icon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: -1
    opacity: 0.8
    $hover:
      opacity: 1

  UIWidget
    id: clockWindow
    size: 29 29
    image-source: images/interface/time_icon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 35
    margin-left: -1
    opacity: 0.8
    $hover:
      opacity: 1

  UIWidget
    id: progressLabelwindow
    size: 29 29
    image-source: images/interface/collect_icon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 68
    margin-left: -1
    visible: false
    opacity: 0.8
    $hover:
      opacity: 1

  UIWidget
    id: recipe
    height: 70
    anchors.top: item.top
    anchors.left: item.left
    anchors.right: parent.right
    margin-top: -11
    margin-left: 402
    phantom: true
    layout:
      type: grid
      cell-size: 30 30
      num-columns: 4
      num-lines: 2
      cell-spacing: 2

CraftRankButton < UIButton
  size: 99 26
  image-clip: 0 26 99 26
  @onClick: modules.game_craft.getServerItems(self:getId())
  $hover !disabled:
    image-clip: 0 78 99 26
  $disabled:
    image-clip: 0 52 99 26
  $on:
    image-clip: 0 0 99 26

UIWindow
  id: craftWindow
  size: 991 639
  anchors.centerIn: parent
  image-source: images/interface/background
  padding: 0
  font: verdana-11px-rounded
  visible: false
  @onEscape: modules.game_craft.hide()

  Label
    id: workName
    size: 336 31
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 500
    margin-top: 33
    image-source: images/title_line
    text-align: top
    font: sans-bold-16px-rounded
    color: #f6e27a

  UIWidget
    id: workImagem
    size: 313 575
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 15
    margin-top: 17

  CraftProgressBar
    id: expBar
    size: 270 32
    background-color: #005189
    anchors.bottom: parent.bottom
    anchors.left: workImagem.left
    margin-bottom: 68
    margin-left: 25

  Label
    id: workLabel
    !text: tr('Skill')
    anchors.left: workImagem.left
    anchors.bottom: expBar.top
    margin-bottom: 4
    margin-left: 30
    text-auto-resize: true

  Label
    id: workpercent
    anchors.centerIn: expBar
    color: white
    text-auto-resize: true

  Label
    id: workNivel
    anchors.bottom: expBar.top
    anchors.right: expBar.right
    margin-bottom: 4
    color: white
    text-auto-resize: true

  Panel
    id: rankPanel
    size: 620 26
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 340
    margin-top: 79
    layout:
      type: horizontalBox
      spacing: 5

    CraftRankButton
      id: E
      image-source: images/ranks_button/E
    CraftRankButton
      id: D
      image-source: images/ranks_button/D
    CraftRankButton
      id: C
      image-source: images/ranks_button/C
    CraftRankButton
      id: B
      image-source: images/ranks_button/B
    CraftRankButton
      id: A
      image-source: images/ranks_button/A
    CraftRankButton
      id: S
      image-source: images/ranks_button/S

  ScrollablePanel
    id: craftListPanel
    size: 594 400
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 52
    margin-top: 120
    vertical-scrollbar: craftListScrollBar
    layout:
      type: verticalBox
      spacing: 1

  VerticalScrollBar
    id: craftListScrollBar
    anchors.top: craftListPanel.top
    anchors.bottom: craftListPanel.bottom
    anchors.left: craftListPanel.right
    margin-left: 10
    step: 48
    pixels-scroll: true

  Button
    id: craftItemCreate
    !text: tr('Craft')
    size: 120 30
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 60
    margin-right: 40
    @onClick: modules.game_craft.showCreateWindow()

  Button
    id: craftItemCollect
    !text: tr('Collect')
    size: 100 30
    anchors.bottom: parent.bottom
    anchors.right: craftItemCreate.left
    margin-bottom: 60
    margin-right: 5
    visible: false
    @onClick: modules.game_craft.collectItemCraft()

  Button
    id: speedUpCraft
    !text: tr('Speed up')
    size: 120 30
    anchors.bottom: parent.bottom
    anchors.right: craftItemCreate.left
    margin-bottom: 60
    margin-right: 5
    visible: false
    @onClick: modules.game_craft.showSpeedUp()

  UIButton
    id: close
    image-source: images/close
    size: 20 21
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    opacity: 0.8
    margin-bottom: 10
    margin-right: 50
    @onClick: modules.game_craft.hide()
    $hover:
      opacity: 1.0
